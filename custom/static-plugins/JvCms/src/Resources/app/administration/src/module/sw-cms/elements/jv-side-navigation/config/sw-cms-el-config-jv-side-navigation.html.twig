{#
  Sidebar settings form for jv-side-navigation.

  Bound to config/index.js: logo upload, tabs/sections CRUD, footer items,
  footerIconOptions. Emits element-update via onUpdate().
#}
{% block sw_cms_el_config_jv_side_navigation %}
	<div class="sw-cms-el-config-jv-side-navigation">
		{# Logo media + optional click-through URL #}
		<div class="sw-cms-el-config-jv-side-navigation__logo">
			<label class="sw-cms-el-config-jv-side-navigation__logo-label">
				{{ $t('cms.elements.jv-side-navigation.config.logoMedia.label') }}
			</label>

			<sw-media-upload-v2
				variant="regular"
				:upload-tag="logoUploadTag"
				:source="logoPreviewSource"
				:allow-multi-select="false"
				:default-folder="cmsPageState.pageEntityName"
				:caption="$t('cms.elements.jv-side-navigation.config.logoMedia.caption')"
				@media-upload-sidebar-open="onOpenLogoMediaModal"
				@media-upload-remove-image="onLogoRemove"
			/>

			<sw-upload-listener
				:upload-tag="logoUploadTag"
				auto-upload
				@media-upload-finish="onLogoUpload"
			/>

			<sw-media-modal-v2
				v-if="mediaModalIsOpen"
				variant="full"
				:caption="$t('cms.elements.jv-side-navigation.config.logoMedia.caption')"
				:entity-context="cmsPageState.entityName"
				:allow-multi-select="false"
				:initial-folder-id="cmsPageState.defaultMediaFolderId"
				@media-modal-selection-change="onLogoSelectionChanges"
				@modal-close="onCloseLogoMediaModal"
			/>
		</div>

		<mt-text-field
			v-model:model-value="element.config.logoLink.value"
			:label="$t('cms.elements.jv-side-navigation.config.logoLink.label')"
			:placeholder="$t('cms.elements.jv-side-navigation.config.logoLink.placeholder')"
			@update:model-value="onUpdate"
		/>

		{# Tabs → each tab owns its sections #}
		<div class="sw-cms-el-config-jv-side-navigation__section">
			<div class="sw-cms-el-config-jv-side-navigation__section-header">
				<h4>{{ $t('cms.elements.jv-side-navigation.config.tabs.title') }}</h4>
				<mt-button size="small" variant="secondary" @click="addTab">
					{{ $t('cms.elements.jv-side-navigation.config.tabs.add') }}
				</mt-button>
			</div>

			<div
				v-for="(tab, tabIndex) in tabs"
				:key="tab.id || tabIndex"
				class="sw-cms-el-config-jv-side-navigation__card"
			>
				<mt-text-field
					v-model:model-value="tab.id"
					:label="$t('cms.elements.jv-side-navigation.config.tabs.id.label')"
					@update:model-value="onUpdate"
				/>
				<mt-text-field
					v-model:model-value="tab.label"
					:label="$t('cms.elements.jv-side-navigation.config.tabs.label.label')"
					@update:model-value="onUpdate"
				/>

				<div class="sw-cms-el-config-jv-side-navigation__subsection">
					<div class="sw-cms-el-config-jv-side-navigation__section-header">
						<h5>{{ $t('cms.elements.jv-side-navigation.config.sections.title') }}</h5>
						<div class="sw-cms-el-config-jv-side-navigation__section-actions">
							<mt-select
								v-model:model-value="pendingSectionType"
								:options="sectionTypeOptions"
								class="sw-cms-el-config-jv-side-navigation__section-type-select"
							/>
							<mt-button size="small" variant="secondary" @click="addSection(tabIndex)">
								{{ $t('cms.elements.jv-side-navigation.config.sections.add') }}
							</mt-button>
						</div>
					</div>

					<div
						v-for="(section, sectionIndex) in tab.sections"
						:key="section.id || sectionIndex"
						class="sw-cms-el-config-jv-side-navigation__section-card"
					>
						<mt-text-field
							v-model:model-value="section.id"
							:label="$t('cms.elements.jv-side-navigation.config.sections.id.label')"
							@update:model-value="onUpdate"
						/>
						<mt-text-field
							:model-value="section.type"
							:label="$t('cms.elements.jv-side-navigation.config.sections.type.label')"
							disabled
						/>

						{# category-tree: root + depth + optional root “all” link #}
						<template v-if="section.type === 'category-tree'">
							<sw-entity-single-select
								v-model:value="section.rootCategoryId"
								entity="category"
								:label="$t('cms.elements.jv-side-navigation.config.sections.categoryTree.rootCategoryId.label')"
								:placeholder="$t('cms.elements.jv-side-navigation.config.sections.categoryTree.rootCategoryId.placeholder')"
								show-clearable-button
								@update:value="onUpdate"
							/>
							<mt-select
								v-model:model-value="section.maxDepth"
								:label="$t('cms.elements.jv-side-navigation.config.sections.categoryTree.maxDepth.label')"
								:options="maxDepthOptions"
								@update:model-value="onUpdate"
							/>
							<mt-switch
								v-model:model-value="section.showIcons"
								:label="$t('cms.elements.jv-side-navigation.config.sections.categoryTree.showIcons.label')"
								@update:model-value="onUpdate"
							/>
							<mt-switch
								v-model:model-value="section.includeRootAsAllLink"
								:label="$t('cms.elements.jv-side-navigation.config.sections.categoryTree.includeRootAsAllLink.label')"
								:help-text="$t('cms.elements.jv-side-navigation.config.sections.categoryTree.includeRootAsAllLink.helpText')"
								@update:model-value="onUpdate"
							/>
							<mt-text-field
								v-if="section.includeRootAsAllLink"
								v-model:model-value="section.allLinkLabel"
								:label="$t('cms.elements.jv-side-navigation.config.sections.categoryTree.allLinkLabel.label')"
								:placeholder="$t('cms.elements.jv-side-navigation.config.sections.categoryTree.allLinkLabel.placeholder')"
								:help-text="$t('cms.elements.jv-side-navigation.config.sections.categoryTree.allLinkLabel.helpText')"
								@update:model-value="onUpdate"
							/>
						</template>

						{# manual-links: recursive items via manual-item component #}
						<template v-else-if="section.type === 'manual-links'">
							<mt-select
								v-model:model-value="section.style"
								:label="$t('cms.elements.jv-side-navigation.config.sections.manualLinks.style.label')"
								:options="manualStyleOptions"
								@update:model-value="onUpdate"
							/>

							<div class="sw-cms-el-config-jv-side-navigation__section-header">
								<h6>{{ $t('cms.elements.jv-side-navigation.config.sections.manualLinks.items.title') }}</h6>
								<mt-button size="small" variant="secondary" @click="addManualLinkItem(section)">
									{{ $t('cms.elements.jv-side-navigation.config.sections.manualLinks.items.add') }}
								</mt-button>
							</div>

							<sw-cms-el-config-jv-side-navigation-manual-item
								v-for="(item, itemIndex) in section.items"
								:key="item.id || itemIndex"
								:item="item"
								:depth="0"
								@update="onUpdate"
								@remove="removeManualLinkItem(section, itemIndex)"
							/>
						</template>

						<template v-else-if="section.type === 'promo'">
							<sw-entity-single-select
								v-model:value="section.mediaId"
								entity="media"
								:label="$t('cms.elements.jv-side-navigation.config.sections.promo.mediaId.label')"
								show-clearable-button
								@update:value="onUpdate"
							/>
							<mt-text-field
								v-model:model-value="section.title"
								:label="$t('cms.elements.jv-side-navigation.config.sections.promo.title.label')"
								@update:model-value="onUpdate"
							/>
							<mt-text-field
								v-model:model-value="section.url"
								:label="$t('cms.elements.jv-side-navigation.config.sections.promo.url.label')"
								@update:model-value="onUpdate"
							/>
							<mt-text-field
								v-model:model-value="section.alt"
								:label="$t('cms.elements.jv-side-navigation.config.sections.promo.alt.label')"
								@update:model-value="onUpdate"
							/>
						</template>

						<mt-button size="small" variant="critical" @click="removeSection(tabIndex, sectionIndex)">
							{{ $t('cms.elements.jv-side-navigation.config.sections.remove') }}
						</mt-button>
					</div>
				</div>

				<mt-button size="small" variant="critical" @click="removeTab(tabIndex)">
					{{ $t('cms.elements.jv-side-navigation.config.tabs.remove') }}
				</mt-button>
			</div>
		</div>

		<mt-select
			v-model:model-value="element.config.defaultTabId.value"
			:label="$t('cms.elements.jv-side-navigation.config.defaultTabId.label')"
			:options="defaultTabOptions"
			:placeholder="$t('cms.elements.jv-side-navigation.config.defaultTabId.placeholder')"
			class="sw-cms-el-config-jv-side-navigation__field"
			@update:model-value="onUpdate"
		/>

		{# Shared footer for all tabs — named icon keys, not media uploads #}
		<div class="sw-cms-el-config-jv-side-navigation__section">
			<div class="sw-cms-el-config-jv-side-navigation__section-header">
				<h4>{{ $t('cms.elements.jv-side-navigation.config.footer.title') }}</h4>
				<mt-button size="small" variant="secondary" @click="addFooterItem">
					{{ $t('cms.elements.jv-side-navigation.config.footer.add') }}
				</mt-button>
			</div>

			<div
				v-for="(item, itemIndex) in footerItems"
				:key="item.id || itemIndex"
				class="sw-cms-el-config-jv-side-navigation__card"
			>
				<mt-text-field
					v-model:model-value="item.id"
					:label="$t('cms.elements.jv-side-navigation.config.footer.id.label')"
					@update:model-value="onUpdate"
				/>
				<mt-text-field
					v-model:model-value="item.label"
					:label="$t('cms.elements.jv-side-navigation.config.footer.label.label')"
					@update:model-value="onUpdate"
				/>
				<mt-text-field
					v-model:model-value="item.href"
					:label="$t('cms.elements.jv-side-navigation.config.footer.href.label')"
					@update:model-value="onUpdate"
				/>
				<mt-select
					v-model:model-value="item.icon"
					:label="$t('cms.elements.jv-side-navigation.config.footer.icon.label')"
					:placeholder="$t('cms.elements.jv-side-navigation.config.footer.icon.placeholder')"
					:help-text="$t('cms.elements.jv-side-navigation.config.footer.icon.helpText')"
					:options="footerIconOptions"
					@update:model-value="onUpdate"
				/>
				<mt-select
					v-model:model-value="item.visibility"
					:label="$t('cms.elements.jv-side-navigation.config.footer.visibility.label')"
					:options="[
						{ value: 'always', label: 'always' },
						{ value: 'guest', label: 'guest' },
						{ value: 'customer', label: 'customer' },
					]"
					@update:model-value="onUpdate"
				/>
				<mt-button size="small" variant="critical" @click="removeFooterItem(itemIndex)">
					{{ $t('cms.elements.jv-side-navigation.config.footer.remove') }}
				</mt-button>
			</div>
		</div>
	</div>
{% endblock %}
