# Tracked contract for compose.deploy.yml interpolation.
# Copy it to the protected environment file used by the deployment runtime.
# Replace every `replace-me` value; never commit real credentials or secrets.

# Shopware runtime
APP_SECRET=replace-me-with-a-random-secret
APP_URL=https://stage.example.invalid
INSTANCE_ID=00000000000000000000000000000000
DATABASE_URL=mysql://shopware:replace-me@database:3306/shopware
MAILER_DSN=null://null
LOCK_DSN=redis://redis:6379/locks
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages
MESSENGER_TRANSPORT_LOW_PRIORITY_DSN=redis://redis:6379/low_priority
MESSENGER_TRANSPORT_FAILURE_DSN=redis://redis:6379/failed

# Aftercool product import
AFTERCOOL_BASE_URI=https://aftercool.de
AFTERCOOL_USERNAME=replace-me
AFTERCOOL_PASSWORD=replace-me
AFTERCOOL_TIMEOUT=20

# Initial Shopware installation
INSTALL_LOCALE=de-DE
INSTALL_CURRENCY=EUR
INSTALL_ADMIN_USERNAME=replace-me
INSTALL_ADMIN_PASSWORD=replace-me
INSTALL_ADMIN_EMAIL=admin@example.invalid
SALES_CHANNEL_URL=https://stage.example.invalid

# Deployment topology and persistent storage
DATA_NETWORK=jvmoebel-stage-data
APP_NETWORK=jvmoebel-stage-application
SHOPWARE_NETWORK_ALIAS=jvmoebel-stage-back
SHOPWARE_STORAGE_PATH=/srv/jvmoebel/stage/back/shared

# Optional container limits; values below equal the Compose defaults.
BOOTSTRAP_MEMORY_LIMIT=1536m
BOOTSTRAP_CPU_LIMIT=2.0
BOOTSTRAP_PIDS_LIMIT=512
WEB_MEMORY_LIMIT=1536m
WEB_CPU_LIMIT=2.0
WEB_PIDS_LIMIT=512
WORKER_MEMORY_LIMIT=768m
WORKER_CPU_LIMIT=1.0
WORKER_PIDS_LIMIT=256
SCHEDULER_MEMORY_LIMIT=768m
SCHEDULER_CPU_LIMIT=1.0
SCHEDULER_PIDS_LIMIT=256
