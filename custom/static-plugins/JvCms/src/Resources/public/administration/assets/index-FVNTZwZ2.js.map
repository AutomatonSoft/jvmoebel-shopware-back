{% block sw_cms_el_config_jv_why_jvmoebel %}
	<div class="sw-cms-el-config-jv-why-jvmoebel">
		<mt-text-field
			v-model:model-value="element.config.mark.value"
			:label="$t('cms.elements.jv-why-jvmoebel.config.mark.label')"
			:placeholder="$t('cms.elements.jv-why-jvmoebel.config.mark.placeholder')"
			@update:model-value="onUpdate"
		/>

		<mt-text-field
			v-model:model-value="element.config.tagline.value"
			:label="$t('cms.elements.jv-why-jvmoebel.config.tagline.label')"
			:placeholder="$t('cms.elements.jv-why-jvmoebel.config.tagline.placeholder')"
			@update:model-value="onUpdate"
		/>

		<mt-text-field
			v-model:model-value="element.config.title.value"
			:label="$t('cms.elements.jv-why-jvmoebel.config.title.label')"
			:placeholder="$t('cms.elements.jv-why-jvmoebel.config.title.placeholder')"
			@update:model-value="onUpdate"
		/>

		<mt-text-field
			v-model:model-value="element.config.eyebrow.value"
			:label="$t('cms.elements.jv-why-jvmoebel.config.eyebrow.label')"
			:placeholder="$t('cms.elements.jv-why-jvmoebel.config.eyebrow.placeholder')"
			@update:model-value="onUpdate"
		/>

		<mt-textarea
			v-model:model-value="element.config.description.value"
			:label="$t('cms.elements.jv-why-jvmoebel.config.description.label')"
			:placeholder="$t('cms.elements.jv-why-jvmoebel.config.description.placeholder')"
			@update:model-value="onUpdate"
		/>

		<div class="sw-cms-el-config-jv-why-jvmoebel__section">
			<div class="sw-cms-el-config-jv-why-jvmoebel__section-header">
				<h4>{{ $t('cms.elements.jv-why-jvmoebel.config.benefits.title') }}</h4>
				<mt-button size="small" variant="secondary" @click="addBenefit">
					{{ $t('cms.elements.jv-why-jvmoebel.config.benefits.add') }}
				</mt-button>
			</div>

			<div
				v-for="(benefit, benefitIndex) in benefits"
				:key="`jv-why-jvmoebel-${benefitIndex}`"
				class="sw-cms-el-config-jv-why-jvmoebel__card"
			>
				<div class="sw-cms-el-config-jv-why-jvmoebel__card-header">
					<strong>{{ $t('cms.elements.jv-why-jvmoebel.config.benefits.cardTitle', { index: benefitIndex + 1 }) }}</strong>
					<mt-button size="small" variant="critical" @click="removeBenefit(benefitIndex)">
						{{ $t('cms.elements.jv-why-jvmoebel.config.benefits.remove') }}
					</mt-button>
				</div>

				<mt-select
					v-model:model-value="benefit.iconMode"
					:label="$t('cms.elements.jv-why-jvmoebel.config.benefits.iconMode.label')"
					:options="iconModeOptions"
					@update:model-value="onIconModeChange(benefit)"
				/>

				<mt-select
					v-if="benefit.iconMode === 'preset'"
					v-model:model-value="benefit.icon"
					:label="$t('cms.elements.jv-why-jvmoebel.config.benefits.icon.label')"
					:options="iconOptions"
					@update:model-value="onUpdate"
				/>

				<div
					v-else
					class="sw-cms-el-config-jv-why-jvmoebel__media"
				>
					<label class="sw-cms-el-config-jv-why-jvmoebel__media-label">
						{{ $t('cms.elements.jv-why-jvmoebel.config.benefits.iconMedia.label') }}
					</label>

					<sw-media-upload-v2
						variant="regular"
						:upload-tag="benefitUploadTag(benefitIndex)"
						:source="benefitIconPreviewSource(benefit)"
						:allow-multi-select="false"
						:default-folder="cmsPageState.pageEntityName"
						:caption="$t('cms.elements.jv-why-jvmoebel.config.benefits.iconMedia.caption')"
						@media-upload-sidebar-open="onOpenBenefitIconMediaModal(benefitIndex)"
						@media-upload-remove-image="onBenefitIconRemove(benefitIndex)"
					/>

					<sw-upload-listener
						:upload-tag="benefitUploadTag(benefitIndex)"
						auto-upload
						@media-upload-finish="onBenefitIconUpload(benefitIndex, $event)"
					/>
				</div>

				<mt-text-field
					v-model:model-value="benefit.id"
					:label="$t('cms.elements.jv-why-jvmoebel.config.benefits.id.label')"
					:help-text="$t('cms.elements.jv-why-jvmoebel.config.benefits.id.helpText')"
					@update:model-value="onUpdate"
				/>

				<mt-text-field
					v-model:model-value="benefit.title"
					:label="$t('cms.elements.jv-why-jvmoebel.config.benefits.titleField.label')"
					@update:model-value="onUpdate"
				/>

				<mt-textarea
					v-model:model-value="benefit.description"
					:label="$t('cms.elements.jv-why-jvmoebel.config.benefits.description.label')"
					@update:model-value="onUpdate"
				/>

				<mt-text-field
					v-model:model-value="benefit.url"
					:label="$t('cms.elements.jv-why-jvmoebel.config.benefits.url.label')"
					:placeholder="$t('cms.elements.jv-why-jvmoebel.config.benefits.url.placeholder')"
					@update:model-value="onUpdate"
				/>
			</div>
		</div>

		<div class="sw-cms-el-config-jv-why-jvmoebel__section">
			<h4>{{ $t('cms.elements.jv-why-jvmoebel.config.viewAll.title') }}</h4>

			<mt-text-field
				v-model:model-value="element.config.viewAll.value.label"
				:label="$t('cms.elements.jv-why-jvmoebel.config.viewAll.label.label')"
				:placeholder="$t('cms.elements.jv-why-jvmoebel.config.viewAll.label.placeholder')"
				@update:model-value="onUpdate"
			/>

			<mt-text-field
				v-model:model-value="element.config.viewAll.value.url"
				:label="$t('cms.elements.jv-why-jvmoebel.config.viewAll.url.label')"
				:placeholder="$t('cms.elements.jv-why-jvmoebel.config.viewAll.url.placeholder')"
				@update:model-value="onUpdate"
			/>
		</div>

		<sw-media-modal-v2
			v-if="mediaModalIndex !== null"
			variant="full"
			:caption="$t('cms.elements.jv-why-jvmoebel.config.benefits.iconMedia.caption')"
			:entity-context="cmsPageState.entityName"
			:allow-multi-select="false"
			:initial-folder-id="cmsPageState.defaultMediaFolderId"
			@media-modal-selection-change="onBenefitIconSelectionChanges"
			@modal-close="onCloseBenefitIconMediaModal"
		/>
	</div>
{% endblock %}
