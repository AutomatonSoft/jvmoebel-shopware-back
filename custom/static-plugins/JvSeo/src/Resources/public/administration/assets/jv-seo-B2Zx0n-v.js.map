{% block jv_seo_redirect_detail %}
<sw-page class="jv-seo-redirect-detail">
    <template #smart-bar-header>
        <h2>{{ isEditing ? $t('jv-seo.detail.editTitle') : $t('jv-seo.detail.createTitle') }}</h2>
    </template>

    <template #smart-bar-actions>
        <mt-button variant="secondary" @click="$router.push({ name: 'jv.seo.index.redirects' })">
            {{ $t('global.default.cancel') }}
        </mt-button>
        <mt-button
            v-if="canEdit"
            variant="primary"
            :is-loading="isSaving"
            :disabled="isLoading"
            @click="save"
        >
            {{ $t('global.default.save') }}
        </mt-button>
    </template>

    <template #content>
        <sw-card-view>
            <mt-banner v-if="validationMessages.length" variant="critical">
                <ul>
                    <li v-for="message in validationMessages" :key="message">{{ message }}</li>
                </ul>
            </mt-banner>

            <mt-card position-identifier="jv-seo-redirect-base" :title="$t('jv-seo.detail.base')" :is-loading="isLoading">
                <sw-single-select
                    v-model:value="draft.type"
                    :label="$t('jv-seo.detail.type')"
                    :options="typeOptions"
                    value-property="value"
                    label-property="label"
                    :disabled="isEditing || !canEdit"
                    @update:value="onTypeChange"
                />

                <sw-entity-single-select
                    v-if="draft.type === 'product'"
                    v-model:value="draft.productId"
                    entity="product"
                    :label="$t('jv-seo.detail.product')"
                    :placeholder="$t('jv-seo.detail.productPlaceholder')"
                    :disabled="isEditing || !canEdit"
                    display-variants
                    @update:value="onProductChange"
                />

                <sw-entity-single-select
                    v-if="draft.type === 'category'"
                    v-model:value="draft.categoryId"
                    entity="category"
                    :label="$t('jv-seo.detail.category')"
                    :placeholder="$t('jv-seo.detail.categoryPlaceholder')"
                    :disabled="isEditing || !canEdit"
                    @update:value="onCategoryChange"
                />

                <sw-entity-single-select
                    v-if="draft.type === 'image'"
                    v-model:value="draft.mediaId"
                    entity="media"
                    label-property="fileName"
                    :criteria="imageCriteria"
                    :label="$t('jv-seo.detail.image')"
                    :placeholder="$t('jv-seo.detail.imagePlaceholder')"
                    :disabled="isEditing || !canEdit"
                    @update:value="onImageChange"
                />
            </mt-card>

            <mt-card
                v-for="channel in draft.channels"
                :key="channel.salesChannelId"
                :position-identifier="`jv-seo-channel-${channel.salesChannelId}`"
            >
                <h3 class="jv-seo-redirect-detail__channel-title">
                    {{ channel.salesChannelName }}
                </h3>

                <sw-switch-field
                    v-model:value="channel.enabled"
                    :label="$t('jv-seo.detail.enableChannel')"
                    :disabled="!canEdit"
                />

                <template v-if="channel.enabled">
                    <sw-text-field
                        v-if="draft.type === 'general'"
                        v-model:value="channel.targetUrl"
                        :label="$t('jv-seo.detail.targetUrl')"
                        :placeholder="$t('jv-seo.detail.absoluteUrlPlaceholder')"
                        :disabled="!canEdit"
                        required
                    />
                    <sw-text-field
                        v-else
                        :value="channel.targetPreview || $t('jv-seo.detail.targetUnavailable')"
                        :label="$t('jv-seo.detail.targetPreview')"
                        disabled
                    />

                    <div class="jv-seo-redirect-detail__sources-heading">
                        <h3>{{ $t('jv-seo.detail.sourceUrls') }}</h3>
                        <mt-button size="small" variant="secondary" :disabled="!canEdit" @click="addSource(channel)">
                            {{ $t('jv-seo.actions.addSource') }}
                        </mt-button>
                    </div>

                    <div
                        v-for="(source, index) in channel.sources"
                        :key="source.localKey"
                        class="jv-seo-redirect-detail__source-row"
                    >
                        <sw-text-field
                            v-model:value="source.url"
                            :label="$t('jv-seo.detail.sourceUrl', { number: index + 1 })"
                            :placeholder="$t('jv-seo.detail.absoluteUrlPlaceholder')"
                            :disabled="!canEdit"
                            required
                        />
                        <mt-button
                            square
                            size="small"
                            variant="critical"
                            :disabled="!canEdit || channel.sources.length <= 1"
                            @click="removeSource(channel, index)"
                        >
                            <mt-icon name="regular-trash" size="16px" />
                        </mt-button>
                    </div>
                </template>
            </mt-card>
        </sw-card-view>
    </template>
</sw-page>
{% endblock %}
