{
    "name": "jvmoebel/seo",
    "description": "JVMöbel SEO and legacy redirect management",
    "type": "shopware-platform-plugin",
    "license": "proprietary",
    "version": "0.1.0",
    "require": {
        "php": "^8.5",
        "shopware/core": "~6.7.0"
    },
    "autoload": {
        "psr-4": {
            "Jv\\Seo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jv\\Seo\\Tests\\": "tests/"
        }
    },
    "extra": {
        "shopware-plugin-class": "Jv\\Seo\\JvSeo",
        "label": {
            "de-DE": "JVMöbel SEO",
            "en-GB": "JVMöbel SEO"
        }
    }
}
