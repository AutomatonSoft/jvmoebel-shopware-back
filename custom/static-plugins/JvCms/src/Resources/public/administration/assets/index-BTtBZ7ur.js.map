{% block sw_cms_el_config_jv_inline_product_teaser %}
	<div class="sw-cms-el-config-jv-inline-product-teaser">
		<sw-entity-single-select
			v-model:value="element.config.productId.value"
			entity="product"
			:label="$t('cms.elements.jv-inline-product-teaser.config.productId.label')"
			:placeholder="$t('cms.elements.jv-inline-product-teaser.config.productId.placeholder')"
			show-clearable-button
			@update:value="onUpdate"
		/>

		<mt-text-field
			v-model:model-value="element.config.name.value"
			:label="$t('cms.elements.jv-inline-product-teaser.config.name.label')"
			:help-text="$t('cms.elements.jv-inline-product-teaser.config.name.helpText')"
			@update:model-value="onUpdate"
		/>

		<mt-textarea
			v-model:model-value="element.config.description.value"
			:label="$t('cms.elements.jv-inline-product-teaser.config.description.label')"
			@update:model-value="onUpdate"
		/>

		<mt-text-field
			v-model:model-value="element.config.url.value"
			:label="$t('cms.elements.jv-inline-product-teaser.config.url.label')"
			:help-text="$t('cms.elements.jv-inline-product-teaser.config.url.helpText')"
			@update:model-value="onUpdate"
		/>

		<div class="sw-cms-el-config-jv-inline-product-teaser__media">
			<label class="sw-cms-el-config-jv-inline-product-teaser__media-label">
				{{ $t('cms.elements.jv-inline-product-teaser.config.imageMedia.label') }}
			</label>

			<sw-media-upload-v2
				variant="regular"
				:upload-tag="uploadTag()"
				:source="imagePreviewSource"
				:allow-multi-select="false"
				:default-folder="cmsPageState.pageEntityName"
				:caption="$t('cms.elements.jv-inline-product-teaser.config.imageMedia.caption')"
				@media-upload-sidebar-open="onOpenMediaModal"
				@media-upload-remove-image="onImageRemove"
			/>

			<sw-upload-listener
				:upload-tag="uploadTag()"
				auto-upload
				@media-upload-finish="onImageUpload"
			/>
		</div>

		<sw-media-modal-v2
			v-if="mediaModalOpen"
			variant="full"
			:caption="$t('cms.elements.jv-inline-product-teaser.config.imageMedia.caption')"
			:entity-context="cmsPageState.entityName"
			:allow-multi-select="false"
			:initial-folder-id="cmsPageState.defaultMediaFolderId"
			@media-modal-selection-change="onMediaSelectionChanges"
			@modal-close="onCloseMediaModal"
		/>
	</div>
{% endblock %}
