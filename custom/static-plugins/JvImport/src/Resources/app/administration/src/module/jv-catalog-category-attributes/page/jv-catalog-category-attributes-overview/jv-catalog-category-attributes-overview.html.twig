<sw-page class="jv-catalog-category-attributes-overview">
    <template #smart-bar-header>
        <h2>{{ $t('jv-catalog-category-attributes.overview.title') }}</h2>
    </template>

    <template #content>
        <sw-card :title="$t('jv-catalog-category-attributes.overview.selectGroup')">
            <sw-entity-single-select
                v-model:value="categoryId"
                entity="category"
                :criteria="categoryCriteria"
                :label="$t('jv-catalog-category-attributes.overview.selectGroup')"
                :placeholder="$t('jv-catalog-category-attributes.overview.searchGroup')"
            />
        </sw-card>

        <jv-catalog-category-attributes
            v-if="categoryId"
            :category-id="categoryId"
        />

        <mt-empty-state
            v-else
            icon="regular-folder-open"
            :headline="$t('jv-catalog-category-attributes.overview.empty.title')"
            :description="$t('jv-catalog-category-attributes.overview.empty.description')"
        />
    </template>
</sw-page>
