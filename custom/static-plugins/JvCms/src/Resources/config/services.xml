        </service>

        <service id="Jv\Cms\DataResolver\Element\ProductGridCmsElementResolver">
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="Jv\Cms\DataResolver\Element\ShopTheLookCmsElementResolver">
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="Jv\Cms\DataResolver\Element\HomeEditorialCmsElementResolver">
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="Jv\Cms\DataResolver\Element\FaqCmsElementResolver">
            <tag name="shopware.cms.data_resolver"/>
        </service>
          
        <service id="Jv\Cms\DataResolver\Element\CategoryRailCmsElementResolver">
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="Jv\Cms\DataResolver\Element\WhyJvmoebelCmsElementResolver">
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="Jv\Cms\DataResolver\Element\CountdownPromoCmsElementResolver">
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="Jv\Cms\DataResolver\Element\PromoDealTilesCmsElementResolver">
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="Jv\Cms\DataResolver\Element\RelatedLookCardsCmsElementResolver">
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="Jv\Cms\DataResolver\Element\ChipRailCmsElementResolver">
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="Jv\Cms\DataResolver\Element\TrendLookGridCmsElementResolver">
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="Jv\Cms\DataResolver\Element\LookSceneCmsElementResolver">
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="Jv\Cms\DataResolver\Element\ColorWorldPickerCmsElementResolver">
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="Jv\Cms\DataResolver\Element\ArticleHeroCmsElementResolver">
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="Jv\Cms\DataResolver\Element\TableOfContentsCmsElementResolver">
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="Jv\Cms\DataResolver\Element\ExpertTipCmsElementResolver">
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="Jv\Cms\DataResolver\Element\ExpertQuoteCmsElementResolver">
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="Jv\Cms\DataResolver\Element\ExpertProfileCmsElementResolver">
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="Jv\Cms\DataResolver\Element\AuthorFooterCmsElementResolver">
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="Jv\Cms\DataResolver\Element\GuideHubCardsCmsElementResolver">
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="Jv\Cms\DataResolver\Element\EditorialTeamGridCmsElementResolver">
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="Jv\Cms\DataResolver\Element\InlineProductTeaserCmsElementResolver">
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="Jv\Cms\DataResolver\Element\InstagramStyleCmsElementResolver">
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="Jv\Cms\DataResolver\Element\TrustRatingCmsElementResolver">
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="Jv\Cms\DataResolver\Element\AppDownloadPromoCmsElementResolver">
            <tag name="shopware.cms.data_resolver"/>
