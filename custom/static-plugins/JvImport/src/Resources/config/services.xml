<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults autowire="true" autoconfigure="true" public="false"/>

        <service id="Jv\Import\Subscriber\CosmoShopProductImportSubscriber">
            <argument type="service" id="Jv\Import\Service\ProductImport\PrepareCosmoShopProductImportRecordService"/>
        </service>
        <service id="Jv\Import\Subscriber\QueueCosmoShopCatalogEnrichmentSubscriber"/>
        <service id="Jv\Import\MessageHandler\CosmoShopCatalogEnrichmentMessageHandler"/>
        <service id="Jv\Import\Subscriber\CatalogProductImportSubscriber"/>
        <service id="Jv\Import\Subscriber\ProductDeliveryTimeCacheInvalidationSubscriber"/>
        <service id="Jv\Import\Subscriber\CmsPageProductDeliveryTimeSubscriber"/>

        <service id="Jv\Import\Subscriber\StoreApi\ProductDeliveryTimeSubscriber" decorates="Shopware\Core\Content\Product\SalesChannel\Detail\ProductDetailRoute">
            <argument type="service" id="Jv\Import\Subscriber\StoreApi\ProductDeliveryTimeSubscriber.inner"/>
        </service>

        <service id="Jv\Import\Subscriber\StoreApi\ProductListingDeliveryTimeSubscriber" decorates="Shopware\Core\Content\Product\SalesChannel\Listing\ProductListingRoute">
            <argument type="service" id="Jv\Import\Subscriber\StoreApi\ProductListingDeliveryTimeSubscriber.inner"/>
        </service>

        <service id="Jv\Import\Subscriber\StoreApi\ProductSearchDeliveryTimeSubscriber" decorates="Shopware\Core\Content\Product\SalesChannel\Search\ProductSearchRoute">
            <argument type="service" id="Jv\Import\Subscriber\StoreApi\ProductSearchDeliveryTimeSubscriber.inner"/>
        </service>

        <service id="Jv\Import\Subscriber\StoreApi\ProductListDeliveryTimeSubscriber" decorates="Shopware\Core\Content\Product\SalesChannel\ProductListRoute">
            <argument type="service" id="Jv\Import\Subscriber\StoreApi\ProductListDeliveryTimeSubscriber.inner"/>
        </service>

        <service id="Jv\Import\Subscriber\StoreApi\ProductSuggestDeliveryTimeSubscriber" decorates="Shopware\Core\Content\Product\SalesChannel\Suggest\ProductSuggestRoute">
            <argument type="service" id="Jv\Import\Subscriber\StoreApi\ProductSuggestDeliveryTimeSubscriber.inner"/>
        </service>

        <service id="Jv\Import\Subscriber\StoreApi\ProductCrossSellingDeliveryTimeSubscriber" decorates="Shopware\Core\Content\Product\SalesChannel\CrossSelling\ProductCrossSellingRoute">
            <argument type="service" id="Jv\Import\Subscriber\StoreApi\ProductCrossSellingDeliveryTimeSubscriber.inner"/>
        </service>

        <service id="Jv\Import\Service\ProductDeliveryTime\SalesChannelProductDeliveryTimeCartProcessor">
            <tag name="shopware.cart.processor" priority="4900"/>
        </service>

        <service id="Jv\Import\Service\ProductImport\ResolveDefaultProductTaxService">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="tax.repository"/>
        </service>

        <service id="Jv\Import\Integration\CosmoShop\Normalizer\CosmoShopProductImportDataNormalizer"/>
        <service id="Jv\Import\Service\ProductImport\Validation\CosmoShopProductImportDataValidator"/>
        <service id="Jv\Import\Service\ProductImport\BuildShopwareProductImportRecordService"/>
        <service id="Jv\Import\Service\ProductDeliveryTime\ResolveSalesChannelProductDeliveryTimesService">
            <argument type="service" id="jv_import_product_sales_channel_delivery_time.repository"/>
        </service>
        <service id="Jv\Import\Service\ProductDeliveryTime\AttachSalesChannelProductDeliveryTimesToStoreApiProductsService"/>
        <service id="Jv\Import\Service\ProductDeliveryTime\ApplySalesChannelProductDeliveryTimesToCartService"/>
        <service id="Jv\Import\Core\Content\ProductSalesChannelDeliveryTime\ProductSalesChannelDeliveryTimeDefinition">
            <tag name="shopware.entity.definition" entity="jv_import_product_sales_channel_delivery_time"/>
        </service>
        <service id="Jv\Import\Core\Content\ProductSalesChannelDeliveryTime\ProductDeliveryTimeExtension">
            <tag name="shopware.entity.extension"/>
        </service>
        <service id="Jv\Import\Core\Content\CatalogCategoryAttribute\CatalogCategoryAttributeDefinition">
            <tag name="shopware.entity.definition" entity="jv_catalog_category_attribute"/>
        </service>

        <service id="Jv\Import\Service\ProductImport\PrepareCosmoShopProductImportRecordService">
            <argument type="service" id="Jv\Import\Integration\CosmoShop\Normalizer\CosmoShopProductImportDataNormalizer"/>
            <argument type="service" id="Jv\Import\Service\ProductImport\Validation\CosmoShopProductImportDataValidator"/>
            <argument type="service" id="Jv\Import\Service\ProductImport\ResolveDefaultProductTaxService"/>
            <argument type="service" id="Jv\Import\Service\ProductImport\BuildShopwareProductImportRecordService"/>
            <argument type="service" id="product.repository"/>
            <argument type="service" id="currency.repository"/>
        </service>

        <service id="Jv\Import\Integration\CosmoShop\Normalizer\CosmoShopReferenceDataNormalizer"/>

        <service id="Jv\Import\Service\ProductImport\LookupData\UpsertProductImportLookupDataService">
            <argument type="service" id="delivery_time.repository"/>
            <argument type="service" id="unit.repository"/>
        </service>

        <service id="Jv\Import\Command\BootstrapCosmoShopProfilesCommand">
            <argument type="service" id="import_export_profile.repository"/>
            <argument key="$environment">%kernel.environment%</argument>
        </service>

        <service id="Jv\Import\Command\UpsertCosmoShopReferencesCommand">
            <argument key="$environment">%kernel.environment%</argument>
        </service>
        <service id="Jv\Import\Command\ImportOkbCatalogSchemaCommand">
            <argument key="$environment">%kernel.environment%</argument>
        </service>
        <service id="Jv\Import\Command\PrepareOkbProductMappingCommand">
            <argument key="$environment">%kernel.environment%</argument>
        </service>
        <service id="Jv\Import\Command\BootstrapCatalogProductImportProfileCommand">
            <argument type="service" id="import_export_profile.repository"/>
        </service>
        <service id="Jv\Import\Command\PrepareCatalogShopwareImportCsvCommand"/>
        <service id="Jv\Import\Command\BackfillCatalogAttributeCategoryRelationsCommand"/>
        <service id="Jv\Import\Command\CleanupLegacyCatalogPropertyGroupsCommand"/>
        <service id="Jv\Import\Command\BackfillCatalogPropertyTranslationsCommand"/>

        <service id="Jv\Import\Integration\Csv\SemicolonCsvReader"/>
        <service id="Jv\Import\Service\Catalog\CatalogAttributeMappingSynchronizer"/>
        <service id="Jv\Import\Service\Catalog\BackfillCatalogAttributeCategoryRelationsService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>
        <service id="Jv\Import\Service\Catalog\CleanupLegacyCatalogPropertyGroupsService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="property_group.repository"/>
        </service>
        <service id="Jv\Import\Service\Catalog\BackfillCatalogPropertyTranslationsService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>
        <service id="Jv\Import\Service\ProductImport\Catalog\PrepareCatalogShopwareImportCsvService">
            <argument type="service" id="Jv\Import\Integration\Csv\SemicolonCsvReader"/>
        </service>
        <service id="Jv\Import\Service\ProductImport\Catalog\CatalogCategoryAttributeSchemaProvider">
            <argument type="service" id="jv_catalog_category_attribute.repository"/>
        </service>
        <service id="Jv\Import\Service\ProductImport\Catalog\PrepareCatalogShopwareProductImportRecordService">
            <argument type="service" id="product.repository"/>
            <argument type="service" id="currency.repository"/>
            <argument type="service" id="Jv\Import\Service\ProductImport\Catalog\CatalogCategoryAttributeSchemaProvider"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Jv\Import\Service\ProductImport\Catalog\CatalogProductImportLookupCache"/>
        </service>
        <service id="Jv\Import\Service\ProductImport\Catalog\CatalogProductImportLookupCache"/>
        <service id="Jv\Import\Service\ProductImport\Catalog\EnrichCosmoShopImportService">
            <argument type="service" id="Shopware\Core\Content\ImportExport\Service\ImportExportService"/>
            <argument type="service" id="shopware.filesystem.private"/>
            <argument type="service" id="Jv\Import\Integration\Okb\Service\PrepareOkbProductMappingService"/>
            <argument type="service" id="Jv\Import\Service\ProductImport\Catalog\PrepareCatalogShopwareImportCsvService"/>
            <argument type="service" id="import_export_profile.repository"/>
            <argument type="service" id="messenger.bus.default"/>
            <argument key="$projectDir">%kernel.project_dir%</argument>
        </service>
        <service id="Jv\Import\Service\ProductImport\Catalog\ReconcileCatalogProductImportRecordService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>
        <service id="Jv\Import\Integration\Okb\OkbCatalogSchemaSnapshotReader"/>
        <service id="Jv\Import\Integration\Okb\OkbProductResponseNormalizer"/>
        <service id="Jv\Import\Integration\Okb\OkbProductApiClient">
            <argument type="service" id="http_client"/>
            <argument type="service" id="Jv\Import\Integration\Okb\OkbProductResponseNormalizer"/>
            <argument key="$baseUri">https://okb.automatonsoft.de</argument>
        </service>
        <service id="Jv\Import\Service\Catalog\ImportCatalogSchemaService">
            <argument type="service" id="category.repository"/>
            <argument type="service" id="property_group.repository"/>
            <argument type="service" id="property_group_option.repository"/>
            <argument type="service" id="jv_catalog_category_attribute.repository"/>
            <argument type="service" id="Jv\Import\Service\Catalog\CatalogAttributeMappingSynchronizer"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\Indexing\EntityIndexerRegistry"/>
        </service>
        <service id="Jv\Import\Integration\Okb\Service\PrepareOkbProductMappingService">
            <argument type="service" id="Jv\Import\Integration\Csv\SemicolonCsvReader"/>
            <argument type="service" id="Jv\Import\Integration\Okb\OkbProductApiClient"/>
        </service>

        <service id="Jv\Import\Integration\CosmoShop\Reader\CosmoShopCsvPreflightReaderFactory">
            <argument key="$environment">%kernel.environment%</argument>
            <tag name="shopware.import_export.reader_factory" priority="100"/>
        </service>

        <service id="Jv\Import\Integration\CosmoShop\Reader\CosmoShopPreflightFailureRegistry"/>
        <service id="Jv\Import\Subscriber\CompleteFailedCosmoShopConsoleImportSubscriber"/>
        <service id="Jv\Import\Subscriber\CosmoShopImportProcessLoggingSubscriber">
            <argument key="$environment">%kernel.environment%</argument>
        </service>
    </services>
</container>
