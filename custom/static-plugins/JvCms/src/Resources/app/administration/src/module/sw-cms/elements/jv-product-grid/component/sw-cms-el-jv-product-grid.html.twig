{% block sw_cms_element_jv_product_grid %}
	<div class="sw-cms-el-jv-product-grid">
		<p v-if="eyebrow" class="sw-cms-el-jv-product-grid__eyebrow">{{ eyebrow }}</p>
		<p class="sw-cms-el-jv-product-grid__title" :class="{ 'sw-cms-el-jv-product-grid__title--placeholder': !title }">
			{{ title || $t('cms.elements.jv-product-grid.component.titlePlaceholder') }}
		</p>

		<div v-if="products.length" class="sw-cms-el-jv-product-grid__grid">
			<div
				v-for="(product, productIndex) in products"
				:key="product.productId || productIndex"
				class="sw-cms-el-jv-product-grid__card"
			>
				<p class="sw-cms-el-jv-product-grid__card-badge" v-if="product.badge">{{ product.badge }}</p>
				<p class="sw-cms-el-jv-product-grid__card-label">
					{{ $t('cms.elements.jv-product-grid.component.productSlot', { index: productIndex + 1 }) }}
				</p>
			</div>
		</div>
		<p v-else class="sw-cms-el-jv-product-grid__empty">
			{{ $t('cms.elements.jv-product-grid.component.noProducts') }}
		</p>

		<p v-if="viewAllLabel" class="sw-cms-el-jv-product-grid__view-all">{{ viewAllLabel }}</p>
	</div>
{% endblock %}
