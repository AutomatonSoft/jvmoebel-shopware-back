<div class="jv-catalog-category-attributes">
    <sw-loader v-if="isMappingLoading || isLoading" />

    <template v-else-if="isSourceCategoryGroup">
        <sw-card
            :title="$t('jv-catalog-category-attributes.sourceCategories.title')"
            :subtitle="$t('jv-catalog-category-attributes.sourceCategories.description')"
        >
            <sw-data-grid
                v-if="sourceCategories.length > 0"
                :data-source="sourceCategories"
                :columns="sourceCategoryColumns"
                :show-selection="false"
                :show-actions="false"
                identifier="jv-catalog-source-categories"
            />
            <mt-empty-state
                v-else
                :headline="$t('jv-catalog-category-attributes.sourceCategories.empty')"
            />
        </sw-card>

        <sw-card
            :title="$t('jv-catalog-category-attributes.mappings.title')"
            :subtitle="$t('jv-catalog-category-attributes.mappings.description')"
        >
            <sw-data-grid
                :data-source="mappings"
                :columns="mappingColumns"
                :show-selection="false"
                :show-actions="false"
                identifier="jv-catalog-category-attributes"
            >
                <template #column-active="{ item }">
                    <sw-icon
                        :name="item.active ? 'regular-checkmark-xs' : 'regular-times-xs'"
                        :color="item.active ? '#37D046' : '#DE294C'"
                        size="16px"
                    />
                </template>

                <template #column-enabled="{ item }">
                    {{ item.enabled ? $t('jv-catalog-category-attributes.enabled') : $t('jv-catalog-category-attributes.disabled') }}
                </template>

                <template #column-storage="{ item }">
                    {{ storageLabel(item.storage) }}
                </template>

                <template #column-target="{ item }">
                    {{ targetLabel(item) }}
                </template>

                <template #column-actions="{ item }">
                    <mt-button
                        size="small"
                        variant="secondary"
                        :disabled="!canEditMappings"
                        @click="openMappingEditor(item)"
                    >
                        {{ $t('jv-catalog-category-attributes.edit') }}
                    </mt-button>
                </template>
            </sw-data-grid>
        </sw-card>

        <sw-modal
            v-if="editableMapping"
            :title="$t('jv-catalog-category-attributes.editor.title', 0, { attribute: editableMapping.attributeName })"
            @modal-close="closeMappingEditor"
        >
            <sw-switch-field
                v-model:value="editableMapping.enabled"
                :label="$t('jv-catalog-category-attributes.columns.import')"
            />

            <sw-single-select
                v-model:value="editableMapping.storage"
                :label="$t('jv-catalog-category-attributes.columns.destination')"
                :options="storageOptions"
                @update:value="onEditorStorageChange"
            />

            <sw-entity-single-select
                v-if="editableMapping.storage === 'property'"
                v-model:value="editableMapping.propertyGroupId"
                entity="property_group"
                :label="$t('jv-catalog-category-attributes.columns.target')"
                :placeholder="$t('jv-catalog-category-attributes.target.selectProperty')"
            />

            <sw-text-field
                v-else-if="editableMapping.storage === 'custom_field'"
                v-model:value="editableMapping.customFieldName"
                :label="$t('jv-catalog-category-attributes.columns.target')"
                :placeholder="$t('jv-catalog-category-attributes.target.catalogJson')"
            />

            <template #modal-footer>
                <mt-button variant="secondary" @click="closeMappingEditor">
                    {{ $t('global.default.cancel') }}
                </mt-button>
                <mt-button
                    variant="primary"
                    :is-loading="savingMappingId === editableMapping.id"
                    @click="saveEditedMapping"
                >
                    {{ $t('global.default.save') }}
                </mt-button>
            </template>
        </sw-modal>
    </template>

    <mt-empty-state
        v-else
        :headline="$t('jv-catalog-category-attributes.notSourceGroup.title')"
        :description="$t('jv-catalog-category-attributes.notSourceGroup.description')"
    />
</div>
