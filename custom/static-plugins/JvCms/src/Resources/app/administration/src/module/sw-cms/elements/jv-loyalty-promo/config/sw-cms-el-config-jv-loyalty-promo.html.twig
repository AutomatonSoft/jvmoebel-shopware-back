{% block sw_cms_el_config_jv_loyalty_promo %}
	<div class="sw-cms-el-config-jv-loyalty-promo">
		<mt-text-field
			v-model:model-value="element.config.title.value"
			:label="$t('cms.elements.jv-loyalty-promo.config.title.label')"
			@update:model-value="onUpdate"
		/>

		<mt-textarea
			v-model:model-value="element.config.description.value"
			:label="$t('cms.elements.jv-loyalty-promo.config.description.label')"
			@update:model-value="onUpdate"
		/>

		<mt-text-field
			v-model:model-value="element.config.promoCode.value"
			:label="$t('cms.elements.jv-loyalty-promo.config.promoCode.label')"
			@update:model-value="onUpdate"
		/>

		<div class="sw-cms-el-config-jv-loyalty-promo__media">
			<label class="sw-cms-el-config-jv-loyalty-promo__media-label">
				{{ $t('cms.elements.jv-loyalty-promo.config.imageMedia.label') }}
			</label>

			<sw-media-upload-v2
				variant="regular"
				:upload-tag="uploadTag()"
				:source="imagePreviewSource"
				:allow-multi-select="false"
				:default-folder="cmsPageState.pageEntityName"
				:caption="$t('cms.elements.jv-loyalty-promo.config.imageMedia.caption')"
				@media-upload-sidebar-open="onOpenMediaModal"
				@media-upload-remove-image="onImageRemove"
			/>

			<sw-upload-listener
				:upload-tag="uploadTag()"
				auto-upload
				@media-upload-finish="onImageUpload"
			/>
		</div>

		<div class="sw-cms-el-config-jv-loyalty-promo__section">
			<div class="sw-cms-el-config-jv-loyalty-promo__section-header">
				<h4>{{ $t('cms.elements.jv-loyalty-promo.config.benefits.title') }}</h4>
				<mt-button size="small" variant="secondary" @click="addBenefit">
					{{ $t('cms.elements.jv-loyalty-promo.config.benefits.add') }}
				</mt-button>
			</div>

			<div
				v-for="(benefit, benefitIndex) in benefits"
				:key="benefit.id || benefitIndex"
				class="sw-cms-el-config-jv-loyalty-promo__card"
			>
				<div class="sw-cms-el-config-jv-loyalty-promo__card-header">
					<strong>{{ $t('cms.elements.jv-loyalty-promo.config.benefits.cardTitle', { index: benefitIndex + 1 }) }}</strong>
					<mt-button size="small" variant="critical" @click="removeBenefit(benefitIndex)">
						{{ $t('cms.elements.jv-loyalty-promo.config.benefits.remove') }}
					</mt-button>
				</div>

				<mt-text-field
					v-model:model-value="benefit.id"
					:label="$t('cms.elements.jv-loyalty-promo.config.benefits.id.label')"
					@update:model-value="onUpdate"
				/>

				<mt-text-field
					v-model:model-value="benefit.text"
					:label="$t('cms.elements.jv-loyalty-promo.config.benefits.text.label')"
					@update:model-value="onUpdate"
				/>
			</div>
		</div>

		<div class="sw-cms-el-config-jv-loyalty-promo__section">
			<h4>{{ $t('cms.elements.jv-loyalty-promo.config.link.title') }}</h4>

			<mt-text-field
				v-model:model-value="element.config.link.value.label"
				:label="$t('cms.elements.jv-loyalty-promo.config.link.label.label')"
				@update:model-value="onUpdate"
			/>

			<mt-text-field
				v-model:model-value="element.config.link.value.url"
				:label="$t('cms.elements.jv-loyalty-promo.config.link.url.label')"
				@update:model-value="onUpdate"
			/>

			<mt-select
				v-model:model-value="element.config.link.value.size"
				:label="$t('cms.elements.jv-loyalty-promo.config.link.size.label')"
				:options="sizeOptions"
				@update:model-value="onUpdate"
			/>
		</div>

		<sw-media-modal-v2
			v-if="mediaModalOpen"
			variant="full"
			:caption="$t('cms.elements.jv-loyalty-promo.config.imageMedia.caption')"
			:entity-context="cmsPageState.entityName"
			:allow-multi-select="false"
			:initial-folder-id="cmsPageState.defaultMediaFolderId"
			@media-modal-selection-change="onMediaSelectionChanges"
			@modal-close="onCloseMediaModal"
		/>
	</div>
{% endblock %}
