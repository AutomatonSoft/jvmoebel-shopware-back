{% block sw_cms_el_config_jv_side_navigation_manual_item %}
	<div class="sw-cms-el-config-jv-side-navigation-manual-item">
		<mt-text-field
			v-model:model-value="item.id"
			:label="$t('cms.elements.jv-side-navigation.config.sections.manualLinks.items.id.label')"
			@update:model-value="onUpdate"
		/>
		<mt-text-field
			v-model:model-value="item.label"
			:label="$t('cms.elements.jv-side-navigation.config.sections.manualLinks.items.label.label')"
			@update:model-value="onUpdate"
		/>
		<mt-text-field
			v-model:model-value="item.url"
			:label="$t('cms.elements.jv-side-navigation.config.sections.manualLinks.items.url.label')"
			@update:model-value="onUpdate"
		/>
		<mt-switch
			v-model:model-value="item.openInNewTab"
			:label="$t('cms.elements.jv-side-navigation.config.sections.manualLinks.items.openInNewTab.label')"
			@update:model-value="onUpdate"
		/>
		<sw-media-field
			:value="item.iconMediaId"
			:label="$t('cms.elements.jv-side-navigation.config.sections.manualLinks.items.iconMediaId.label')"
			@update:value="onIconChange"
		/>

		<div
			v-if="canAddChild"
			class="sw-cms-el-config-jv-side-navigation-manual-item__children"
		>
			<div class="sw-cms-el-config-jv-side-navigation-manual-item__children-header">
				<h6>{{ $t('cms.elements.jv-side-navigation.config.sections.manualLinks.items.children.title') }}</h6>
				<mt-button size="small" variant="secondary" @click="addChild">
					{{ $t('cms.elements.jv-side-navigation.config.sections.manualLinks.items.children.add') }}
				</mt-button>
			</div>

			<sw-cms-el-config-jv-side-navigation-manual-item
				v-for="(child, childIndex) in item.children"
				:key="child.id || childIndex"
				:item="child"
				:depth="depth + 1"
				@update="onUpdate"
				@remove="removeChild(childIndex)"
			/>
		</div>

		<mt-button size="small" variant="critical" @click="$emit('remove')">
			{{ $t('cms.elements.jv-side-navigation.config.sections.manualLinks.items.remove') }}
		</mt-button>
	</div>
{% endblock %}
