# Copy this file to .env.local for local development only; it is not production configuration.
# The example secret is acceptable only because compose publishes every service port to loopback.
# Generate unique values before sharing this environment with anyone else.
APP_ENV=dev
APP_URL=http://localhost:8000
APP_SECRET=local-development-only-change-me
INSTANCE_ID=00000000000000000000000000000000
BLUE_GREEN_DEPLOYMENT=0
COMPOSER_HOME=/tmp/composer
LOCK_DSN=flock
OPENSEARCH_URL=http://opensearch:9200
ADMIN_OPENSEARCH_URL=http://opensearch:9200
