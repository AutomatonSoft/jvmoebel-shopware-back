{% block sw_cms_el_config_jv_text_custom_tables %}
	<div class="sw-cms-el-config-jv-text-custom-tables">
		<div class="sw-cms-el-config-jv-text-custom-tables__rich-text">
			<label>{{ $t('cms.elements.jv-text-custom-tables.config.topText.label') }}</label>
			<sw-text-editor
				v-model:value="element.config.topText.value"
				:placeholder="$t('cms.elements.jv-text-custom-tables.config.topText.placeholder')"
				@update:value="onUpdate"
			/>
		</div>

		<div class="sw-cms-el-config-jv-text-custom-tables__section">
			<div class="sw-cms-el-config-jv-text-custom-tables__section-header">
				<h4>{{ $t('cms.elements.jv-text-custom-tables.config.sections.title') }}</h4>
				<mt-button size="small" variant="secondary" @click="addSection">
					{{ $t('cms.elements.jv-text-custom-tables.config.sections.add') }}
				</mt-button>
			</div>

			<div
				v-for="(section, sectionIndex) in sections"
				:key="section.id || sectionIndex"
				class="sw-cms-el-config-jv-text-custom-tables__card"
			>
				<div class="sw-cms-el-config-jv-text-custom-tables__card-header">
					<strong>{{ $t('cms.elements.jv-text-custom-tables.config.sections.cardTitle', { index: sectionIndex + 1 }) }}</strong>
					<div class="sw-cms-el-config-jv-text-custom-tables__actions">
						<mt-button size="small" variant="secondary" :disabled="sectionIndex === 0" @click="moveSection(sectionIndex, -1)">
							{{ $t('cms.elements.jv-text-custom-tables.config.sections.moveUp') }}
						</mt-button>
						<mt-button size="small" variant="secondary" :disabled="sectionIndex === sections.length - 1" @click="moveSection(sectionIndex, 1)">
							{{ $t('cms.elements.jv-text-custom-tables.config.sections.moveDown') }}
						</mt-button>
						<mt-button size="small" variant="critical" @click="removeSection(sectionIndex)">
							{{ $t('cms.elements.jv-text-custom-tables.config.sections.remove') }}
						</mt-button>
					</div>
				</div>

				<mt-text-field
					v-model:model-value="section.title"
					:label="$t('cms.elements.jv-text-custom-tables.config.sections.titleField.label')"
					:placeholder="$t('cms.elements.jv-text-custom-tables.config.sections.titleField.placeholder')"
					@update:model-value="onUpdate"
				/>

				<div class="sw-cms-el-config-jv-text-custom-tables__table-header">
					<h5>{{ $t('cms.elements.jv-text-custom-tables.config.rows.title') }}</h5>
					<mt-button size="small" variant="secondary" @click="addRow(section)">
						{{ $t('cms.elements.jv-text-custom-tables.config.rows.add') }}
					</mt-button>
				</div>

				<div
					v-for="(row, rowIndex) in section.rows"
					:key="rowIndex"
					class="sw-cms-el-config-jv-text-custom-tables__row"
				>
					<mt-text-field
						v-model:model-value="row.left"
						:label="$t('cms.elements.jv-text-custom-tables.config.rows.left.label')"
						:placeholder="$t('cms.elements.jv-text-custom-tables.config.rows.left.placeholder')"
						@update:model-value="onUpdate"
					/>
					<mt-text-field
						v-model:model-value="row.right"
						:label="$t('cms.elements.jv-text-custom-tables.config.rows.right.label')"
						:placeholder="$t('cms.elements.jv-text-custom-tables.config.rows.right.placeholder')"
						@update:model-value="onUpdate"
					/>
					<div class="sw-cms-el-config-jv-text-custom-tables__actions">
						<mt-button size="small" variant="secondary" :disabled="rowIndex === 0" @click="moveRow(section, rowIndex, -1)">
							{{ $t('cms.elements.jv-text-custom-tables.config.rows.moveUp') }}
						</mt-button>
						<mt-button size="small" variant="secondary" :disabled="rowIndex === section.rows.length - 1" @click="moveRow(section, rowIndex, 1)">
							{{ $t('cms.elements.jv-text-custom-tables.config.rows.moveDown') }}
						</mt-button>
						<mt-button size="small" variant="critical" @click="removeRow(section, rowIndex)">
							{{ $t('cms.elements.jv-text-custom-tables.config.rows.remove') }}
						</mt-button>
					</div>
				</div>

				<div class="sw-cms-el-config-jv-text-custom-tables__rich-text">
					<label>{{ $t('cms.elements.jv-text-custom-tables.config.sections.text.label') }}</label>
					<sw-text-editor
						v-model:value="section.text"
						:placeholder="$t('cms.elements.jv-text-custom-tables.config.sections.text.placeholder')"
						@update:value="onUpdate"
					/>
				</div>
			</div>
		</div>

		<div class="sw-cms-el-config-jv-text-custom-tables__rich-text">
			<label>{{ $t('cms.elements.jv-text-custom-tables.config.bottomText.label') }}</label>
			<sw-text-editor
				v-model:value="element.config.bottomText.value"
				:placeholder="$t('cms.elements.jv-text-custom-tables.config.bottomText.placeholder')"
				@update:value="onUpdate"
			/>
		</div>
	</div>
{% endblock %}
