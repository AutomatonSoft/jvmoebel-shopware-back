#!/bin/sh

set -eu

if [ "${SHOPWARE_INITIAL_INSTALL:-0}" = "1" ]; then
    php bin/console system:install \
        --force \
        --shop-name="${SHOPWARE_SHOP_NAME:?SHOPWARE_SHOP_NAME is required}" \
        --shop-email="${SHOPWARE_SHOP_EMAIL:?SHOPWARE_SHOP_EMAIL is required}" \
        --shop-locale=de-DE \
        --shop-currency=EUR \
        --skip-first-run-wizard \
        --no-interaction

    php bin/console user:create \
        "${SHOPWARE_ADMIN_USERNAME:?SHOPWARE_ADMIN_USERNAME is required}" \
        --admin \
        --password="${SHOPWARE_ADMIN_PASSWORD:?SHOPWARE_ADMIN_PASSWORD is required}" \
        --no-interaction
fi

php bin/console database:migrate --all --no-interaction
php bin/console plugin:refresh
php bin/console plugin:install --activate --clearCache --no-interaction JvMarketConfiguration JvCms JvImport
php bin/console scheduled-task:register --no-interaction
php bin/console cache:clear --no-interaction
