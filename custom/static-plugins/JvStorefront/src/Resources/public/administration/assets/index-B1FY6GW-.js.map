{% block jv_storefront_settings_index %}
<sw-page class="jv-storefront-settings-index">
    {% block jv_storefront_settings_index_smart_bar %}
    <template #smart-bar-header>
        <h2>{{ $t('jv-storefront-settings.general.title') }}</h2>
    </template>

    <template #smart-bar-actions>
        <sw-button
            variant="primary"
            :disabled="isSaving || !salesChannel"
            :isLoading="isSaving"
            @click="saveCustomFields"
        >
            {{ $t('global.default.save') }}
        </sw-button>
    </template>
    {% endblock %}

    {% block jv_storefront_settings_index_content %}
    <template #content>
        <sw-card-view>
            <sw-card :title="$t('jv-storefront-settings.salesChannel.title')">
                <sw-entity-single-select
                    v-model:value="salesChannelId"
                    entity="sales_channel"
                    :label="$t('jv-storefront-settings.salesChannel.label')"
                    @update:value="onSalesChannelChange"
                />
            </sw-card>

            <sw-card v-if="salesChannel" :title="$t('jv-storefront-settings.navigation.title')">
                <sw-entity-single-select
                    v-model:value="navigationRootCategoryId"
                    entity="category"
                    :label="$t('jv-storefront-settings.navigation.rootCategory')"
                    show-clearable-button
                    @update:value="onNavigationRootChange"
                />

                <p class="jv-storefront-settings-index__navigation-help">
                    {{ $t('jv-storefront-settings.navigation.helpText') }}
                </p>

                <sw-loader v-if="isHeaderNavigationLoading" />

                <sw-sortable-list
                    v-else-if="navigationRootCategoryId && headerNavigationLinks.length"
                    :key="headerNavigationSortableKey"
                    class="jv-storefront-settings-index__navigation-list"
                    :items="headerNavigationLinks"
                    @items-sorted="onHeaderNavigationSorted"
                >
                    <template #item="{ item }">
                        <div class="jv-storefront-settings-index__navigation-item">
                            <mt-icon
                                class="jv-storefront-settings-index__navigation-item-grip"
                                name="regular-grip-vertical"
                            />
                            <sw-checkbox-field
                                :label="item.label"
                                :value="item.visible"
                                @update:value="onHeaderNavigationVisibilityChange(item, $event)"
                            />
                        </div>
                    </template>
                </sw-sortable-list>

                <p
                    v-else-if="navigationRootCategoryId && !isHeaderNavigationLoading"
                    class="jv-storefront-settings-index__navigation-empty"
                >
                    {{ $t('jv-storefront-settings.navigation.empty') }}
                </p>
            </sw-card>

            <sw-card v-if="salesChannel" :title="$t('jv-storefront-settings.branding.title')">
                <div class="jv-storefront-settings-index__logo">
                    <label class="jv-storefront-settings-index__logo-label">
                        {{ $t('jv-storefront-settings.branding.logo') }}
                    </label>

                    <sw-media-upload-v2
                        variant="regular"
                        :upload-tag="logoUploadTag"
                        :source="logoPreviewSource"
                        :allow-multi-select="false"
                        :caption="$t('jv-storefront-settings.branding.logoCaption')"
                        :on-media-upload-sidebar-open="onOpenLogoMediaModal"
                        @media-upload-sidebar-open="onOpenLogoMediaModal"
                        @media-upload-remove-image="onLogoRemove"
                    />

                    <sw-upload-listener
                        :upload-tag="logoUploadTag"
                        auto-upload
                        @media-upload-finish="onLogoUpload"
                    />
                </div>
            </sw-card>

            <sw-card v-if="salesChannel" :title="$t('jv-storefront-settings.footer.title')">
                <sw-text-field
                    v-model:value="customFields.jv_footer_about_eyebrow"
                    :label="$t('jv-storefront-settings.footer.eyebrow')"
                />
                <sw-text-field
                    v-model:value="customFields.jv_footer_about_title"
                    :label="$t('jv-storefront-settings.footer.titleField')"
                />
                <sw-textarea-field
                    v-model:modelValue="customFields.jv_footer_about_description"
                    :label="$t('jv-storefront-settings.footer.description')"
                />
                <sw-text-field
                    v-model:value="customFields.jv_footer_copyright_text"
                    :label="$t('jv-storefront-settings.footer.copyright')"
                />
                <sw-switch-field
                    v-model:value="customFields.jv_footer_revocation_enabled"
                    :label="$t('jv-storefront-settings.footer.revocationEnabled')"
                />
                <sw-text-field
                    v-model:value="customFields.jv_footer_revocation_button_label"
                    :label="$t('jv-storefront-settings.footer.revocationLabel')"
                />
                <sw-text-field
                    v-model:value="customFields.jv_footer_revocation_recipient_email"
                    :label="$t('jv-storefront-settings.footer.revocationEmail')"
                />
            </sw-card>

            <mt-card
                v-if="salesChannel"
                position-identifier="jv-storefront-settings-social-links"
                :title="$t('jv-storefront-settings.social.title')"
            >
                <template #toolbar>
                    <mt-button
                        size="small"
                        variant="secondary"
                        :disabled="!salesChannelId"
                        @click="openSocialLinkCreate"
                    >
                        {{ $t('jv-storefront-settings.actions.add') }}
                    </mt-button>
                </template>

                <sw-data-grid
                    v-if="salesChannelId"
                    identifier="jv-storefront-settings-social-links"
                    :data-source="socialLinks"
                    :columns="socialLinkGridColumns"
                    :is-loading="isSocialLinksLoading"
                    :show-selection="false"
                    :show-settings="false"
                >
                    <template #column-active="{ item }">
                        <span class="sw-data-grid__cell-value">{{ formatActive(item.active) }}</span>
                    </template>

                    <template #actions="{ item }">
                        <sw-context-menu-item @click="openSocialLinkEdit(item)">
                            {{ $t('global.default.edit') }}
                        </sw-context-menu-item>
                        <sw-context-menu-item
                            variant="danger"
                            @click="deleteSocialLink(item)"
                        >
                            {{ $t('global.default.delete') }}
                        </sw-context-menu-item>
                    </template>
                </sw-data-grid>
            </mt-card>

            <mt-card
                v-if="salesChannel"
                position-identifier="jv-storefront-settings-payment-badges"
                :title="$t('jv-storefront-settings.payment.title')"
            >
                <template #toolbar>
                    <mt-button
                        size="small"
                        variant="secondary"
                        :disabled="!salesChannelId"
                        @click="openPaymentBadgeCreate"
                    >
                        {{ $t('jv-storefront-settings.actions.add') }}
                    </mt-button>
                </template>

                <sw-data-grid
                    v-if="salesChannelId"
                    identifier="jv-storefront-settings-payment-badges"
                    :data-source="paymentBadges"
                    :columns="paymentBadgeGridColumns"
                    :is-loading="isPaymentBadgesLoading"
                    :show-selection="false"
                    :show-settings="false"
                >
                    <template #column-active="{ item }">
                        <span class="sw-data-grid__cell-value">{{ formatActive(item.active) }}</span>
                    </template>

                    <template #actions="{ item }">
                        <sw-context-menu-item @click="openPaymentBadgeEdit(item)">
                            {{ $t('global.default.edit') }}
                        </sw-context-menu-item>
                        <sw-context-menu-item
                            variant="danger"
                            @click="deletePaymentBadge(item)"
                        >
                            {{ $t('global.default.delete') }}
                        </sw-context-menu-item>
                    </template>
                </sw-data-grid>
            </mt-card>

            <mt-card
                v-if="salesChannel"
                position-identifier="jv-storefront-settings-shipping-badges"
                :title="$t('jv-storefront-settings.shipping.title')"
            >
                <template #toolbar>
                    <mt-button
                        size="small"
                        variant="secondary"
                        :disabled="!salesChannelId"
                        @click="openShippingBadgeCreate"
                    >
                        {{ $t('jv-storefront-settings.actions.add') }}
                    </mt-button>
                </template>

                <sw-data-grid
                    v-if="salesChannelId"
                    identifier="jv-storefront-settings-shipping-badges"
                    :data-source="shippingBadges"
                    :columns="shippingBadgeGridColumns"
                    :is-loading="isShippingBadgesLoading"
                    :show-selection="false"
                    :show-settings="false"
                >
                    <template #column-active="{ item }">
                        <span class="sw-data-grid__cell-value">{{ formatActive(item.active) }}</span>
                    </template>

                    <template #actions="{ item }">
                        <sw-context-menu-item @click="openShippingBadgeEdit(item)">
                            {{ $t('global.default.edit') }}
                        </sw-context-menu-item>
                        <sw-context-menu-item
                            variant="danger"
                            @click="deleteShippingBadge(item)"
                        >
                            {{ $t('global.default.delete') }}
                        </sw-context-menu-item>
                    </template>
                </sw-data-grid>
            </mt-card>

            <mt-card
                v-if="salesChannel"
                position-identifier="jv-storefront-settings-international-links"
                :title="$t('jv-storefront-settings.international.title')"
            >
                <template #toolbar>
                    <mt-button
                        size="small"
                        variant="secondary"
                        :disabled="!salesChannelId"
                        @click="openInternationalLinkCreate"
                    >
                        {{ $t('jv-storefront-settings.actions.add') }}
                    </mt-button>
                </template>

                <sw-data-grid
                    v-if="salesChannelId"
                    identifier="jv-storefront-settings-international-links"
                    :data-source="internationalLinks"
                    :columns="internationalLinkGridColumns"
                    :is-loading="isInternationalLinksLoading"
                    :show-selection="false"
                    :show-settings="false"
                >
                    <template #column-targetSalesChannel="{ item }">
                        <span class="sw-data-grid__cell-value">{{ formatTargetSalesChannelName(item) }}</span>
                    </template>

                    <template #column-active="{ item }">
                        <span class="sw-data-grid__cell-value">{{ formatActive(item.active) }}</span>
                    </template>

                    <template #actions="{ item }">
                        <sw-context-menu-item @click="openInternationalLinkEdit(item)">
                            {{ $t('global.default.edit') }}
                        </sw-context-menu-item>
                        <sw-context-menu-item
                            variant="danger"
                            @click="deleteInternationalLink(item)"
                        >
                            {{ $t('global.default.delete') }}
                        </sw-context-menu-item>
                    </template>
                </sw-data-grid>
            </mt-card>

            <mt-card
                v-if="salesChannel"
                position-identifier="jv-storefront-settings-contact-channels"
                :title="$t('jv-storefront-settings.contact.title')"
            >
                <template #toolbar>
                    <mt-button
                        size="small"
                        variant="secondary"
                        :disabled="!salesChannelId"
                        @click="openContactChannelCreate"
                    >
                        {{ $t('jv-storefront-settings.actions.add') }}
                    </mt-button>
                </template>

                <p class="jv-storefront-settings-index__navigation-help">
                    {{ $t('jv-storefront-settings.contact.helpText') }}
                </p>

                <sw-data-grid
                    v-if="salesChannelId"
                    identifier="jv-storefront-settings-contact-channels"
                    :data-source="contactChannels"
                    :columns="contactChannelGridColumns"
                    :is-loading="isContactChannelsLoading"
                    :show-selection="false"
                    :show-settings="false"
                >
                    <template #column-type="{ item }">
                        <span class="sw-data-grid__cell-value">{{ formatContactChannelType(item) }}</span>
                    </template>

                    <template #column-active="{ item }">
                        <span class="sw-data-grid__cell-value">{{ formatActive(item.active) }}</span>
                    </template>

                    <template #actions="{ item }">
                        <sw-context-menu-item @click="openContactChannelEdit(item)">
                            {{ $t('global.default.edit') }}
                        </sw-context-menu-item>
                        <sw-context-menu-item
                            variant="danger"
                            @click="deleteContactChannel(item)"
                        >
                            {{ $t('global.default.delete') }}
                        </sw-context-menu-item>
                    </template>
                </sw-data-grid>
            </mt-card>
        </sw-card-view>

        <sw-media-modal-v2
            v-if="logoMediaModalOpen"
            variant="full"
            :caption="$t('jv-storefront-settings.branding.logoCaption')"
            entity-context="sales_channel"
            :allow-multi-select="false"
            @media-modal-selection-change="onLogoSelectionChanges"
            @modal-close="onCloseLogoMediaModal"
        />

        <sw-media-modal-v2
            v-if="iconMediaModalOpen"
            variant="full"
            :caption="$t('jv-storefront-settings.list.iconCaption')"
            entity-context="sales_channel"
            :allow-multi-select="false"
            @media-modal-selection-change="onIconMediaSelectionChanges"
            @modal-close="onCloseIconMediaModal"
        />

        <mt-modal-root
            :is-open="socialLinkModalOpen"
            @change="onSocialLinkModalChange"
        >
            <mt-modal
                v-if="socialLinkDraft"
                class="jv-storefront-settings-modal"
                width="s"
                :title="isSocialLinkCreate ? $t('jv-storefront-settings.modal.socialCreate') : $t('jv-storefront-settings.modal.socialEdit')"
            >
                <sw-text-field
                    v-model:value="socialLinkDraft.label"
                    :label="$t('jv-storefront-settings.list.label')"
                    required
                />
                <sw-text-field
                    v-model:value="socialLinkDraft.url"
                    :label="$t('jv-storefront-settings.list.url')"
                    required
                />
                <div class="jv-storefront-settings-index__icon-field">
                    <label class="jv-storefront-settings-index__logo-label">
                        {{ $t('jv-storefront-settings.list.icon') }}
                    </label>

                    <sw-media-upload-v2
                        variant="regular"
                        :upload-tag="socialLinkIconUploadTag"
                        :source="socialLinkIconPreviewSource"
                        :allow-multi-select="false"
                        :caption="$t('jv-storefront-settings.list.iconCaption')"
                        :on-media-upload-sidebar-open="openSocialLinkIconMediaModal"
                        @media-upload-sidebar-open="openSocialLinkIconMediaModal"
                        @media-upload-remove-image="onSocialLinkIconRemove"
                    />

                    <sw-upload-listener
                        :upload-tag="socialLinkIconUploadTag"
                        auto-upload
                        @media-upload-finish="onSocialLinkIconUpload"
                    />
                </div>
                <mt-number-field
                    v-model="socialLinkDraft.position"
                    number-type="int"
                    :label="$t('jv-storefront-settings.list.position')"
                />
                <sw-switch-field
                    v-model:value="socialLinkDraft.active"
                    :label="$t('jv-storefront-settings.list.active')"
                />
                <sw-switch-field
                    v-model:value="socialLinkDraft.openInNewTab"
                    :label="$t('jv-storefront-settings.list.openInNewTab')"
                />

                <template #footer>
                    <mt-modal-close
                        as="mt-button"
                        size="small"
                        variant="secondary"
                    >
                        {{ $t('global.default.cancel') }}
                    </mt-modal-close>
                    <mt-modal-action
                        as="mt-button"
                        size="small"
                        variant="primary"
                        :is-loading="isSocialLinkSaving"
                        @click="saveSocialLinkDraft"
                    >
                        {{ $t('global.default.save') }}
                    </mt-modal-action>
                </template>
            </mt-modal>
        </mt-modal-root>

        <mt-modal-root
            :is-open="paymentBadgeModalOpen"
            @change="onPaymentBadgeModalChange"
        >
            <mt-modal
                v-if="paymentBadgeDraft"
                class="jv-storefront-settings-modal"
                width="s"
                :title="isPaymentBadgeCreate ? $t('jv-storefront-settings.modal.paymentCreate') : $t('jv-storefront-settings.modal.paymentEdit')"
            >
                <sw-text-field
                    v-model:value="paymentBadgeDraft.label"
                    :label="$t('jv-storefront-settings.list.label')"
                    required
                />
                <div class="jv-storefront-settings-index__icon-field">
                    <label class="jv-storefront-settings-index__logo-label">
                        {{ $t('jv-storefront-settings.list.icon') }}
                    </label>

                    <sw-media-upload-v2
                        variant="regular"
                        :upload-tag="paymentBadgeIconUploadTag"
                        :source="paymentBadgeIconPreviewSource"
                        :allow-multi-select="false"
                        :caption="$t('jv-storefront-settings.list.iconCaption')"
                        :on-media-upload-sidebar-open="openPaymentBadgeIconMediaModal"
                        @media-upload-sidebar-open="openPaymentBadgeIconMediaModal"
                        @media-upload-remove-image="onPaymentBadgeIconRemove"
                    />

                    <sw-upload-listener
                        :upload-tag="paymentBadgeIconUploadTag"
                        auto-upload
                        @media-upload-finish="onPaymentBadgeIconUpload"
                    />
                </div>
                <mt-number-field
                    v-model="paymentBadgeDraft.position"
                    number-type="int"
                    :label="$t('jv-storefront-settings.list.position')"
                />
                <sw-switch-field
                    v-model:value="paymentBadgeDraft.active"
                    :label="$t('jv-storefront-settings.list.active')"
                />

                <template #footer>
                    <mt-modal-close
                        as="mt-button"
                        size="small"
                        variant="secondary"
                    >
                        {{ $t('global.default.cancel') }}
                    </mt-modal-close>
                    <mt-modal-action
                        as="mt-button"
                        size="small"
                        variant="primary"
                        :is-loading="isPaymentBadgeSaving"
                        @click="savePaymentBadgeDraft"
                    >
                        {{ $t('global.default.save') }}
                    </mt-modal-action>
                </template>
            </mt-modal>
        </mt-modal-root>

        <mt-modal-root
            :is-open="shippingBadgeModalOpen"
            @change="onShippingBadgeModalChange"
        >
            <mt-modal
                v-if="shippingBadgeDraft"
                class="jv-storefront-settings-modal"
                width="s"
                :title="isShippingBadgeCreate ? $t('jv-storefront-settings.modal.shippingCreate') : $t('jv-storefront-settings.modal.shippingEdit')"
            >
                <sw-text-field
                    v-model:value="shippingBadgeDraft.label"
                    :label="$t('jv-storefront-settings.list.label')"
                    :help-text="$t('jv-storefront-settings.shipping.labelHelp')"
                />
                <div class="jv-storefront-settings-index__icon-field">
                    <label class="jv-storefront-settings-index__logo-label">
                        {{ $t('jv-storefront-settings.list.icon') }}
                    </label>

                    <sw-media-upload-v2
                        variant="regular"
                        :upload-tag="shippingBadgeIconUploadTag"
                        :source="shippingBadgeIconPreviewSource"
                        :allow-multi-select="false"
                        :caption="$t('jv-storefront-settings.list.iconCaption')"
                        :on-media-upload-sidebar-open="openShippingBadgeIconMediaModal"
                        @media-upload-sidebar-open="openShippingBadgeIconMediaModal"
                        @media-upload-remove-image="onShippingBadgeIconRemove"
                    />

                    <sw-upload-listener
                        :upload-tag="shippingBadgeIconUploadTag"
                        auto-upload
                        @media-upload-finish="onShippingBadgeIconUpload"
                    />
                </div>
                <mt-number-field
                    v-model="shippingBadgeDraft.position"
                    number-type="int"
                    :label="$t('jv-storefront-settings.list.position')"
                />
                <sw-switch-field
                    v-model:value="shippingBadgeDraft.active"
                    :label="$t('jv-storefront-settings.list.active')"
                />

                <template #footer>
                    <mt-modal-close
                        as="mt-button"
                        size="small"
                        variant="secondary"
                    >
                        {{ $t('global.default.cancel') }}
                    </mt-modal-close>
                    <mt-modal-action
                        as="mt-button"
                        size="small"
                        variant="primary"
                        :is-loading="isShippingBadgeSaving"
                        @click="saveShippingBadgeDraft"
                    >
                        {{ $t('global.default.save') }}
                    </mt-modal-action>
                </template>
            </mt-modal>
        </mt-modal-root>

        <mt-modal-root
            :is-open="internationalLinkModalOpen"
            @change="onInternationalLinkModalChange"
        >
            <mt-modal
                v-if="internationalLinkDraft"
                class="jv-storefront-settings-modal"
                width="s"
                :title="isInternationalLinkCreate ? $t('jv-storefront-settings.modal.internationalCreate') : $t('jv-storefront-settings.modal.internationalEdit')"
            >
                <sw-entity-single-select
                    v-model:value="internationalLinkDraft.targetSalesChannelId"
                    entity="sales_channel"
                    :criteria="targetSalesChannelCriteria"
                    :label="$t('jv-storefront-settings.international.targetSalesChannel')"
                    required
                />
                <sw-text-field
                    v-model:value="internationalLinkDraft.label"
                    :label="$t('jv-storefront-settings.list.label')"
                    :help-text="$t('jv-storefront-settings.international.labelHelp')"
                />
                <div class="jv-storefront-settings-index__icon-field">
                    <label class="jv-storefront-settings-index__logo-label">
                        {{ $t('jv-storefront-settings.international.flagIcon') }}
                    </label>

                    <sw-media-upload-v2
                        variant="regular"
                        :upload-tag="internationalLinkIconUploadTag"
                        :source="internationalLinkIconPreviewSource"
                        :allow-multi-select="false"
                        :caption="$t('jv-storefront-settings.international.flagIconCaption')"
                        :on-media-upload-sidebar-open="openInternationalLinkIconMediaModal"
                        @media-upload-sidebar-open="openInternationalLinkIconMediaModal"
                        @media-upload-remove-image="onInternationalLinkIconRemove"
                    />

                    <sw-upload-listener
                        :upload-tag="internationalLinkIconUploadTag"
                        auto-upload
                        @media-upload-finish="onInternationalLinkIconUpload"
                    />
                </div>
                <mt-number-field
                    v-model="internationalLinkDraft.position"
                    number-type="int"
                    :label="$t('jv-storefront-settings.list.position')"
                />
                <sw-switch-field
                    v-model:value="internationalLinkDraft.active"
                    :label="$t('jv-storefront-settings.list.active')"
                />
                <sw-switch-field
                    v-model:value="internationalLinkDraft.openInNewTab"
                    :label="$t('jv-storefront-settings.list.openInNewTab')"
                />

                <template #footer>
                    <mt-modal-close
                        as="mt-button"
                        size="small"
                        variant="secondary"
                    >
                        {{ $t('global.default.cancel') }}
                    </mt-modal-close>
                    <mt-modal-action
                        as="mt-button"
                        size="small"
                        variant="primary"
                        :is-loading="isInternationalLinkSaving"
                        @click="saveInternationalLinkDraft"
                    >
                        {{ $t('global.default.save') }}
                    </mt-modal-action>
                </template>
            </mt-modal>
        </mt-modal-root>

        <mt-modal-root
            :is-open="contactChannelModalOpen"
            @change="onContactChannelModalChange"
        >
            <mt-modal
                v-if="contactChannelDraft"
                class="jv-storefront-settings-modal"
                width="s"
                :title="isContactChannelCreate ? $t('jv-storefront-settings.modal.contactCreate') : $t('jv-storefront-settings.modal.contactEdit')"
            >
                <sw-single-select
                    v-model:value="contactChannelDraft.type"
                    :options="contactChannelTypeOptions"
                    :label="$t('jv-storefront-settings.contact.type')"
                    required
                />
                <sw-text-field
                    v-model:value="contactChannelDraft.url"
                    :label="$t('jv-storefront-settings.list.url')"
                    :placeholder="$t('jv-storefront-settings.contact.urlPlaceholder')"
                    :help-text="$t('jv-storefront-settings.contact.urlHelp')"
                    required
                />
                <sw-text-field
                    v-model:value="contactChannelDraft.label"
                    :label="$t('jv-storefront-settings.list.label')"
                    :help-text="$t('jv-storefront-settings.contact.labelHelp')"
                />
                <div class="jv-storefront-settings-index__icon-field">
                    <label class="jv-storefront-settings-index__logo-label">
                        {{ $t('jv-storefront-settings.list.icon') }}
                    </label>

                    <sw-media-upload-v2
                        variant="regular"
                        :upload-tag="contactChannelIconUploadTag"
                        :source="contactChannelIconPreviewSource"
                        :allow-multi-select="false"
                        :caption="$t('jv-storefront-settings.contact.iconCaption')"
                        :on-media-upload-sidebar-open="openContactChannelIconMediaModal"
                        @media-upload-sidebar-open="openContactChannelIconMediaModal"
                        @media-upload-remove-image="onContactChannelIconRemove"
                    />

                    <sw-upload-listener
                        :upload-tag="contactChannelIconUploadTag"
                        auto-upload
                        @media-upload-finish="onContactChannelIconUpload"
                    />
                </div>
                <mt-number-field
                    v-model="contactChannelDraft.position"
                    number-type="int"
                    :label="$t('jv-storefront-settings.list.position')"
                />
                <sw-switch-field
                    v-model:value="contactChannelDraft.active"
                    :label="$t('jv-storefront-settings.list.active')"
                />

                <template #footer>
                    <mt-modal-close
                        as="mt-button"
                        size="small"
                        variant="secondary"
                    >
                        {{ $t('global.default.cancel') }}
                    </mt-modal-close>
                    <mt-modal-action
                        as="mt-button"
                        size="small"
                        variant="primary"
                        :is-loading="isContactChannelSaving"
                        @click="saveContactChannelDraft"
                    >
                        {{ $t('global.default.save') }}
                    </mt-modal-action>
                </template>
            </mt-modal>
        </mt-modal-root>
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
