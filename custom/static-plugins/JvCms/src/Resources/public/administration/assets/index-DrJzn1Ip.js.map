{% block sw_cms_el_config_jv_expert_tip %}
	<div class="sw-cms-el-config-jv-expert-tip">
		<mt-text-field
			v-model:model-value="element.config.label.value"
			:label="$t('cms.elements.jv-expert-tip.config.label.label')"
			:placeholder="$t('cms.elements.jv-expert-tip.config.label.placeholder')"
			:help-text="$t('cms.elements.jv-expert-tip.config.label.helpText')"
			@update:model-value="onUpdate"
		/>

		<mt-text-field
			v-model:model-value="element.config.title.value"
			:label="$t('cms.elements.jv-expert-tip.config.title.label')"
			:placeholder="$t('cms.elements.jv-expert-tip.config.title.placeholder')"
			@update:model-value="onUpdate"
		/>

		<label class="sw-cms-el-config-jv-expert-tip__media-label">
			{{ $t('cms.elements.jv-expert-tip.config.body.label') }}
		</label>
		<sw-text-editor
			v-model:value="element.config.body.value"
			:placeholder="$t('cms.elements.jv-expert-tip.config.body.placeholder')"
			@update:value="onUpdate"
		/>
	</div>
{% endblock %}
