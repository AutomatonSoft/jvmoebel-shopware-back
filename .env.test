# Local test defaults. Production secrets must never be used here.
APP_ENV=test
APP_SECRET=local-test-only
# Test bootstrap must never inherit development Messenger streams. PHPUnit
# repeats these values because Docker injects .env.local into the web container.
MESSENGER_TRANSPORT_DSN=redis://redis:6379/test_messages
MESSENGER_TRANSPORT_LOW_PRIORITY_DSN=redis://redis:6379/test_low_priority
MESSENGER_TRANSPORT_FAILURE_DSN=redis://redis:6379/test_failed
LOCK_DSN=flock
