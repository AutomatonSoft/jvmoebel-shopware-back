{% block sw_cms_el_config_jv_hero %}
	<div class="sw-cms-el-config-jv-hero">
		<mt-text-field
			v-model:model-value="element.config.title.value"
			:label="$t('cms.elements.jv-hero.config.title.label')"
			:placeholder="$t('cms.elements.jv-hero.config.title.placeholder')"
			@update:model-value="onUpdate"
		/>

		<mt-text-field
			v-model:model-value="element.config.eyebrow.value"
			:label="$t('cms.elements.jv-hero.config.eyebrow.label')"
			:placeholder="$t('cms.elements.jv-hero.config.eyebrow.placeholder')"
			class="sw-cms-el-config-jv-hero__field"
			@update:model-value="onUpdate"
		/>

		<mt-textarea
			v-model:model-value="element.config.description.value"
			:label="$t('cms.elements.jv-hero.config.description.label')"
			:placeholder="$t('cms.elements.jv-hero.config.description.placeholder')"
			class="sw-cms-el-config-jv-hero__field"
			@update:model-value="onUpdate"
		/>

		<div class="sw-cms-el-config-jv-hero__image sw-cms-el-config-jv-hero__field">
			<label class="sw-cms-el-config-jv-hero__image-label">
				{{ $t('cms.elements.jv-hero.config.imageMedia.label') }}
			</label>

			<sw-media-upload-v2
				variant="regular"
				:upload-tag="imageUploadTag"
				:source="imagePreviewSource"
				:allow-multi-select="false"
				:default-folder="cmsPageState.pageEntityName"
				:caption="$t('cms.elements.jv-hero.config.imageMedia.caption')"
				@media-upload-sidebar-open="onOpenImageMediaModal"
				@media-upload-remove-image="onImageRemove"
			/>

			<sw-upload-listener
				:upload-tag="imageUploadTag"
				auto-upload
				@media-upload-finish="onImageUpload"
			/>

			<sw-media-modal-v2
				v-if="mediaModalIsOpen"
				variant="full"
				:caption="$t('cms.elements.jv-hero.config.imageMedia.caption')"
				:entity-context="cmsPageState.entityName"
				:allow-multi-select="false"
				:initial-folder-id="cmsPageState.defaultMediaFolderId"
				@media-modal-selection-change="onImageSelectionChanges"
				@modal-close="onCloseImageMediaModal"
			/>
		</div>

		<div class="sw-cms-el-config-jv-hero__link-group sw-cms-el-config-jv-hero__field">
			<h4 class="sw-cms-el-config-jv-hero__link-title">
				{{ $t('cms.elements.jv-hero.config.primaryLink.title') }}
			</h4>

			<mt-text-field
				v-model:model-value="element.config.primaryLink.value.label"
				:label="$t('cms.elements.jv-hero.config.link.label')"
				:placeholder="$t('cms.elements.jv-hero.config.link.labelPlaceholder')"
				@update:model-value="onUpdate"
			/>

			<mt-text-field
				v-model:model-value="element.config.primaryLink.value.url"
				:label="$t('cms.elements.jv-hero.config.link.url')"
				:placeholder="$t('cms.elements.jv-hero.config.link.urlPlaceholder')"
				class="sw-cms-el-config-jv-hero__field"
				@update:model-value="onUpdate"
			/>

			<mt-select
				v-model:model-value="element.config.primaryLink.value.size"
				:label="$t('cms.elements.jv-hero.config.link.size.label')"
				:options="sizeOptions"
				class="sw-cms-el-config-jv-hero__field"
				@update:model-value="onUpdate"
			/>
		</div>

		<div class="sw-cms-el-config-jv-hero__link-group sw-cms-el-config-jv-hero__field">
			<h4 class="sw-cms-el-config-jv-hero__link-title">
				{{ $t('cms.elements.jv-hero.config.secondaryLink.title') }}
			</h4>

			<mt-text-field
				v-model:model-value="element.config.secondaryLink.value.label"
				:label="$t('cms.elements.jv-hero.config.link.label')"
				:placeholder="$t('cms.elements.jv-hero.config.link.labelPlaceholder')"
				@update:model-value="onUpdate"
			/>

			<mt-text-field
				v-model:model-value="element.config.secondaryLink.value.url"
				:label="$t('cms.elements.jv-hero.config.link.url')"
				:placeholder="$t('cms.elements.jv-hero.config.link.urlPlaceholder')"
				class="sw-cms-el-config-jv-hero__field"
				@update:model-value="onUpdate"
			/>

			<mt-select
				v-model:model-value="element.config.secondaryLink.value.size"
				:label="$t('cms.elements.jv-hero.config.link.size.label')"
				:options="sizeOptions"
				class="sw-cms-el-config-jv-hero__field"
				@update:model-value="onUpdate"
			/>
		</div>
	</div>
{% endblock %}
