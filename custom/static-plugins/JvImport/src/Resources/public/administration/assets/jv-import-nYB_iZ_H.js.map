<sw-card-view>
    <sw-card :title="$t('jv-import.aftercool.title')" :is-loading="loadingFactories">
        <sw-single-select
            v-model:value="factoryId"
            :options="factories.map((factory) => ({ value: factory.id, label: `${factory.name} (${factory.id})` }))"
            :label="$t('jv-import.aftercool.factory')"
        />
        <sw-button variant="primary" :disabled="!canStart" @click="start">
            {{ $t('jv-import.aftercool.start') }}
        </sw-button>
        <sw-button class="jv-aftercool-import__refresh" :disabled="loadingFactories" @click="loadFactories">
            {{ $t('jv-import.aftercool.refresh') }}
        </sw-button>
        <p v-if="previewReady && factoryTotal !== null">{{ $t('jv-import.aftercool.importWholeFactory', { count: factoryTotal }) }}</p>
        <p v-if="previewReady && previewQuery">{{ $t('jv-import.aftercool.filteredPreview', { count: previewTotal, total: factoryTotal }) }}</p>
    </sw-card>

    <sw-card v-if="factoryId" :title="$t('jv-import.aftercool.preview')" :is-loading="previewLoading">
        <sw-text-field v-model:value="previewQuery" :label="$t('jv-import.aftercool.search')" @update:value="onPreviewSearch" />
        <sw-data-grid :data-source="preview" :columns="previewColumns" :show-selection="false" :show-actions="false">
            <template #column-previewImage="{ item }"><img v-if="item.previewImage" :src="item.previewImage" width="40" :alt="item.name || ''"></template>
            <template #column-name="{ item }">{{ item.name || '—' }}</template>
            <template #column-ean="{ item }">{{ item.ean || '—' }}</template>
            <template #column-source="{ item }">{{ item.artikelnummer || '—' }} / {{ item.productId || '—' }}</template>
            <template #column-manufacturer="{ item }">{{ item.manufacturer || '—' }}</template>
            <template #column-price="{ item }">{{ item.price === null ? '—' : item.price }}</template>
            <template #column-stock="{ item }">{{ item.stock === null ? '—' : item.stock }}</template>
            <template #column-dimensions="{ item }">{{ item.dimensions || '—' }}</template>
            <template #column-weight="{ item }">{{ item.weight || '—' }}</template>
            <template #column-updatedAt="{ item }">{{ item.updatedAt || '—' }}</template>
            <template #column-status="{ item }">{{ item.importable ? $t('jv-import.aftercool.ready') : item.issues.join(', ') }}</template>
            <template #column-details="{ item }"><sw-button size="small" @click="previewDetail = item">{{ $t('jv-import.aftercool.details') }}</sw-button></template>
        </sw-data-grid>
        <sw-pagination :page="previewPage" :limit="previewLimit" :total="previewTotal" :steps="[previewLimit]" @page-change="onPreviewPageChange" />
    </sw-card>

    <sw-modal v-if="previewDetail" :title="previewDetail.name || previewDetail.productId" @modal-close="previewDetail = null">
        <p><strong>{{ $t('jv-import.aftercool.source') }}:</strong> {{ previewDetail.sourceFile || '—' }} / {{ previewDetail.sourceKind || '—' }}</p>
        <p v-if="previewDetail.description">{{ previewDetail.description }}</p>
        <ul v-if="previewDetail.mediaUrls.length">
            <li v-for="url in previewDetail.mediaUrls" :key="url"><a :href="url" target="_blank" rel="noopener noreferrer">{{ url }}</a></li>
        </ul>
    </sw-modal>

    <sw-card v-if="run" :title="$t('jv-import.aftercool.progress')">
        <sw-progress-bar :value="run.total ? (run.processed / run.total) * 100 : 0" />
        <p>{{ run.status }} — {{ run.processed }} / {{ run.total || '?' }}</p>
        <p>{{ $t('jv-import.aftercool.counters', run) }}</p>
        <p v-if="run.failureCode || run.failureMessage">{{ $t('jv-import.aftercool.failure', { code: run.failureCode || '—', message: run.failureMessage || '—' }) }}</p>
    </sw-card>

    <sw-card v-if="run && errorsTotal > 0" :title="$t('jv-import.aftercool.errors')">
        <p>{{ $tc('jv-import.aftercool.errorsTotal', errorsTotal, { count: errorsTotal }) }}</p>
        <sw-data-grid :data-source="errors" :columns="errorColumns" :show-selection="false" :show-actions="false">
            <template #column-code="{ item }">{{ item.code }}</template>
            <template #column-ean="{ item }">{{ item.ean || item.artikelnummer || item.productId || '—' }}</template>
            <template #column-message="{ item }">{{ item.message }}</template>
        </sw-data-grid>
        <sw-pagination
            v-if="errorsTotal > errorsLimit"
            :page="errorsPage"
            :limit="errorsLimit"
            :total="errorsTotal"
            :steps="[errorsLimit]"
            @page-change="onErrorsPageChange"
        />
    </sw-card>
</sw-card-view>
