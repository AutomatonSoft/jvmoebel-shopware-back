# Tracked Shopware Dotenv template for host CLI.
# Container runtime uses the ignored .env.local generated by bin/setup-local.
# Secrets are placeholders only — never put production credentials here.
APP_ENV=dev
APP_DEBUG=1
APP_URL=http://localhost:8000
APP_SECRET=local-development-only-change-me
INSTANCE_ID=00000000000000000000000000000000
BLUE_GREEN_DEPLOYMENT=0
COMPOSER_HOME=/tmp/composer
LOCK_DSN=flock
DATABASE_URL=mysql://root:root@127.0.0.1:3306/shopware
MAILER_DSN=smtp://127.0.0.1:1025
MESSENGER_TRANSPORT_DSN=redis://127.0.0.1:6379/messages
MESSENGER_TRANSPORT_LOW_PRIORITY_DSN=redis://127.0.0.1:6379/low_priority
MESSENGER_TRANSPORT_FAILURE_DSN=redis://127.0.0.1:6379/failed
TRUSTED_PROXIES=REMOTE_ADDR
SYMFONY_TRUSTED_PROXIES=REMOTE_ADDR
OPENSEARCH_URL=http://127.0.0.1:9200
ADMIN_OPENSEARCH_URL=http://127.0.0.1:9200
SHOPWARE_ES_ENABLED=1
SHOPWARE_ES_INDEXING_ENABLED=1
SHOPWARE_ES_INDEX_PREFIX=sw
SHOPWARE_ES_THROW_EXCEPTION=1
SHOPWARE_HTTP_CACHE_ENABLED=0
JV_MARKET_SALES_CHANNEL_URL_TEMPLATE=https://{domain}

# Aftercool product import. Credentials must be provided per environment.
AFTERCOOL_BASE_URI=https://aftercool.de
AFTERCOOL_USERNAME=
AFTERCOOL_PASSWORD=
AFTERCOOL_TIMEOUT=20
