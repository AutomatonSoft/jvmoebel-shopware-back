{
    "name": "shopware/production",
    "description": "JVMöbel Shopware backend",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5",
        "composer-runtime-api": "^2.0",
        "jvmoebel/cms": "^0.1.0",
        "jvmoebel/import": "^0.1",
        "jvmoebel/market-configuration": "^0.1",
        "jvmoebel/storefront": "^0.1.0",
        "shopware/administration": "*",
        "shopware/core": "6.7.12.2",
        "shopware/deployment-helper": "*",
        "shopware/elasticsearch": "*",
        "shopware/storefront": "*",
        "symfony/flex": "~2",
        "symfony/redis-messenger": "^8.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "custom/plugins/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "custom/plugins/*/packages/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "custom/static-plugins/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "composer",
            "url": "https://shopware.github.io/conflicts/"
        }
    ],
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "lint": "php-cs-fixer fix --dry-run --diff --using-cache=no",
        "format": "php-cs-fixer fix --using-cache=no",
        "analyse": "phpstan analyse --configuration=phpstan.dist.neon --memory-limit=1G",
        "test": "phpunit --configuration=phpunit.dist.xml",
        "auto-scripts": {
            "assets:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "docker": false,
            "endpoint": [
                "https://raw.githubusercontent.com/shopware/recipes/flex/main/index.json",
                "flex://defaults"
            ]
        }
    },
    "require-dev": {
        "php-cs-fixer/shim": "^3",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2",
        "phpstan/phpstan-strict-rules": "^2",
        "phpstan/phpstan-symfony": "^2",
        "phpunit/phpunit": "^11.5",
        "shopware/dev-tools": "^1.5"
    }
}
