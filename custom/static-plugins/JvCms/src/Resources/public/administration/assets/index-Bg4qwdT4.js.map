{% block sw_cms_el_config_jv_offer_rail %}
	<div class="sw-cms-el-config-jv-offer-rail">
		<mt-text-field
			v-model:model-value="element.config.title.value"
			:label="$t('cms.elements.jv-offer-rail.config.title.label')"
			@update:model-value="onUpdate"
		/>

		<mt-text-field
			v-model:model-value="element.config.eyebrow.value"
			:label="$t('cms.elements.jv-offer-rail.config.eyebrow.label')"
			@update:model-value="onUpdate"
		/>

		<mt-textarea
			v-model:model-value="element.config.description.value"
			:label="$t('cms.elements.jv-offer-rail.config.description.label')"
			@update:model-value="onUpdate"
		/>

		<mt-text-field
			v-model:model-value="element.config.ariaLabel.value"
			:label="$t('cms.elements.jv-offer-rail.config.ariaLabel.label')"
			@update:model-value="onUpdate"
		/>

		<div class="sw-cms-el-config-jv-offer-rail__section">
			<div class="sw-cms-el-config-jv-offer-rail__section-header">
				<h4>{{ $t('cms.elements.jv-offer-rail.config.offers.title') }}</h4>
				<mt-button size="small" variant="secondary" @click="addOffer">
					{{ $t('cms.elements.jv-offer-rail.config.offers.add') }}
				</mt-button>
			</div>

			<div
				v-for="(offer, offerIndex) in offers"
				:key="offer.id || offerIndex"
				class="sw-cms-el-config-jv-offer-rail__card"
			>
				<div class="sw-cms-el-config-jv-offer-rail__card-header">
					<strong>{{ $t('cms.elements.jv-offer-rail.config.offers.cardTitle', { index: offerIndex + 1 }) }}</strong>
					<mt-button size="small" variant="critical" @click="removeOffer(offerIndex)">
						{{ $t('cms.elements.jv-offer-rail.config.offers.remove') }}
					</mt-button>
				</div>

				<div class="sw-cms-el-config-jv-offer-rail__media">
					<label class="sw-cms-el-config-jv-offer-rail__media-label">
						{{ $t('cms.elements.jv-offer-rail.config.offers.imageMedia.label') }}
					</label>

					<sw-media-upload-v2
						variant="regular"
						:upload-tag="offerUploadTag(offerIndex)"
						:source="offerPreviewSource(offer)"
						:allow-multi-select="false"
						:default-folder="cmsPageState.pageEntityName"
						:caption="$t('cms.elements.jv-offer-rail.config.offers.imageMedia.caption')"
						@media-upload-sidebar-open="onOpenOfferMediaModal(offerIndex)"
						@media-upload-remove-image="onOfferRemove(offerIndex)"
					/>

					<sw-upload-listener
						:upload-tag="offerUploadTag(offerIndex)"
						auto-upload
						@media-upload-finish="onOfferUpload(offerIndex, $event)"
					/>
				</div>

				<mt-text-field
					v-model:model-value="offer.title"
					:label="$t('cms.elements.jv-offer-rail.config.offers.title.label')"
					@update:model-value="onUpdate"
				/>

				<mt-text-field
					v-model:model-value="offer.subtitle"
					:label="$t('cms.elements.jv-offer-rail.config.offers.subtitle.label')"
					@update:model-value="onUpdate"
				/>

				<mt-text-field
					v-model:model-value="offer.ctaLabel"
					:label="$t('cms.elements.jv-offer-rail.config.offers.ctaLabel.label')"
					@update:model-value="onUpdate"
				/>

				<mt-text-field
					v-model:model-value="offer.url"
					:label="$t('cms.elements.jv-offer-rail.config.offers.url.label')"
					@update:model-value="onUpdate"
				/>

				<mt-text-field
					v-model:model-value="offer.endsAt"
					:label="$t('cms.elements.jv-offer-rail.config.offers.endsAt.label')"
					:help-text="$t('cms.elements.jv-offer-rail.config.offers.endsAt.helpText')"
					@update:model-value="onUpdate"
				/>

				<mt-text-field
					v-model:model-value="offer.legalText"
					:label="$t('cms.elements.jv-offer-rail.config.offers.legalText.label')"
					@update:model-value="onUpdate"
				/>
			</div>
		</div>

		<sw-media-modal-v2
			v-if="mediaModalIndex !== null"
			:allow-multi-select="false"
			:entity-context="cmsPageState.pageEntityName"
			@media-modal-selection-change="onOfferSelectionChanges"
			@modal-close="onCloseOfferMediaModal"
		/>
	</div>
{% endblock %}
