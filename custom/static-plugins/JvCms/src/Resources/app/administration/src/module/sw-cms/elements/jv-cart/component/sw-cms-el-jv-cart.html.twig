{% block sw_cms_element_jv_cart %}
	<div class="sw-cms-el-jv-cart">
		<div class="sw-cms-el-jv-cart__header">
			<span class="sw-cms-el-jv-cart__icon">🛒</span>
			<span class="sw-cms-el-jv-cart__header-label">{{ headerLabel }}</span>
			<span class="sw-cms-el-jv-cart__badge">1</span>
		</div>
		<div class="sw-cms-el-jv-cart__title">{{ pageTitle }}</div>
		<div class="sw-cms-el-jv-cart__hint">{{ $t('cms.elements.jv-cart.component.previewHint') }}</div>
	</div>
{% endblock %}
