{% block sw_cms_el_config_jv_home_editorial %}
	<div class="sw-cms-el-config-jv-home-editorial">
		<mt-select
			v-model:model-value="element.config.appearance.value"
			:label="$t('cms.elements.jv-home-editorial.config.appearance.label')"
			:options="appearanceOptions"
			@update:model-value="onUpdate"
		/>

		<mt-text-field
			v-model:model-value="element.config.statement.value"
			:label="$t('cms.elements.jv-home-editorial.config.statement.label')"
			:placeholder="$t('cms.elements.jv-home-editorial.config.statement.placeholder')"
			@update:model-value="onUpdate"
		/>

		<mt-text-field
			v-model:model-value="element.config.title.value"
			:label="$t('cms.elements.jv-home-editorial.config.title.label')"
			:placeholder="$t('cms.elements.jv-home-editorial.config.title.placeholder')"
			@update:model-value="onUpdate"
		/>

		<div class="sw-cms-el-config-jv-home-editorial__section">
			<div class="sw-cms-el-config-jv-home-editorial__section-header">
				<h4>{{ $t('cms.elements.jv-home-editorial.config.introduction.title') }}</h4>
				<mt-button size="small" variant="secondary" @click="addIntroductionParagraph">
					{{ $t('cms.elements.jv-home-editorial.config.paragraph.add') }}
				</mt-button>
			</div>

			<div
				v-for="(paragraph, paragraphIndex) in introduction"
				:key="paragraphIndex"
				class="sw-cms-el-config-jv-home-editorial__paragraph"
			>
				<div class="sw-cms-el-config-jv-home-editorial__paragraph-header">
					<strong>{{ $t('cms.elements.jv-home-editorial.config.paragraph.title', { index: paragraphIndex + 1 }) }}</strong>
					<div class="sw-cms-el-config-jv-home-editorial__actions">
						<mt-button size="small" variant="secondary" :disabled="paragraphIndex === 0" @click="moveIntroductionParagraph(paragraphIndex, -1)">
							{{ $t('cms.elements.jv-home-editorial.config.moveUp') }}
						</mt-button>
						<mt-button size="small" variant="secondary" :disabled="paragraphIndex === introduction.length - 1" @click="moveIntroductionParagraph(paragraphIndex, 1)">
							{{ $t('cms.elements.jv-home-editorial.config.moveDown') }}
						</mt-button>
						<mt-button size="small" variant="critical" @click="removeIntroductionParagraph(paragraphIndex)">
							{{ $t('cms.elements.jv-home-editorial.config.remove') }}
						</mt-button>
					</div>
				</div>

				<sw-text-editor
					v-model:value="introduction[paragraphIndex]"
					:placeholder="$t('cms.elements.jv-home-editorial.config.paragraph.placeholder')"
					@update:value="onUpdate"
				/>
			</div>
		</div>

		<div class="sw-cms-el-config-jv-home-editorial__section">
			<div class="sw-cms-el-config-jv-home-editorial__section-header">
				<h4>{{ $t('cms.elements.jv-home-editorial.config.sections.title') }}</h4>
				<mt-button size="small" variant="secondary" @click="addSection">
					{{ $t('cms.elements.jv-home-editorial.config.sections.add') }}
				</mt-button>
			</div>

			<div
				v-for="(section, sectionIndex) in sections"
				:key="section.id || sectionIndex"
				class="sw-cms-el-config-jv-home-editorial__card"
				:class="cmsValidationBlockClass(`sections.${sectionIndex}`)"
			>
				<div class="sw-cms-el-config-jv-home-editorial__card-header">
					<strong>{{ $t('cms.elements.jv-home-editorial.config.sections.cardTitle', { index: sectionIndex + 1 }) }}</strong>
					<div class="sw-cms-el-config-jv-home-editorial__actions">
						<mt-button size="small" variant="secondary" :disabled="sectionIndex === 0" @click="moveSection(sectionIndex, -1)">
							{{ $t('cms.elements.jv-home-editorial.config.moveUp') }}
						</mt-button>
						<mt-button size="small" variant="secondary" :disabled="sectionIndex === sections.length - 1" @click="moveSection(sectionIndex, 1)">
							{{ $t('cms.elements.jv-home-editorial.config.moveDown') }}
						</mt-button>
						<mt-button size="small" variant="critical" @click="removeSection(sectionIndex)">
							{{ $t('cms.elements.jv-home-editorial.config.remove') }}
						</mt-button>
					</div>
				</div>

				<mt-text-field
					v-model:model-value="section.id"
					:label="$t('cms.elements.jv-home-editorial.config.sections.id.label')"
					:help-text="$t('cms.elements.jv-home-editorial.config.sections.id.helpText')"
					@update:model-value="onUpdate"
				/>

				<mt-text-field
					v-model:model-value="section.title"
					:label="$t('cms.elements.jv-home-editorial.config.sections.titleField.label')"
					:placeholder="$t('cms.elements.jv-home-editorial.config.sections.titleField.placeholder')"
					@update:model-value="onUpdate"
				/>

				<div class="sw-cms-el-config-jv-home-editorial__subsection-header">
					<h5>{{ $t('cms.elements.jv-home-editorial.config.sections.paragraphs') }}</h5>
					<mt-button size="small" variant="secondary" @click="addSectionParagraph(section)">
						{{ $t('cms.elements.jv-home-editorial.config.paragraph.add') }}
					</mt-button>
				</div>

				<mt-banner
					v-if="cmsValidationBlockError(`sections.${sectionIndex}`)"
					class="sw-cms-el-config-jv-home-editorial__paragraph-error"
					variant="critical"
					:show-icon="true"
				>
					{{ cmsValidationBlockError(`sections.${sectionIndex}`).detail }}
				</mt-banner>

				<div
					v-for="(paragraph, paragraphIndex) in section.paragraphs"
					:key="paragraphIndex"
					class="sw-cms-el-config-jv-home-editorial__paragraph"
				>
					<div class="sw-cms-el-config-jv-home-editorial__paragraph-header">
						<strong>{{ $t('cms.elements.jv-home-editorial.config.paragraph.title', { index: paragraphIndex + 1 }) }}</strong>
						<div class="sw-cms-el-config-jv-home-editorial__actions">
							<mt-button size="small" variant="secondary" :disabled="paragraphIndex === 0" @click="moveSectionParagraph(section, paragraphIndex, -1)">
								{{ $t('cms.elements.jv-home-editorial.config.moveUp') }}
							</mt-button>
							<mt-button size="small" variant="secondary" :disabled="paragraphIndex === section.paragraphs.length - 1" @click="moveSectionParagraph(section, paragraphIndex, 1)">
								{{ $t('cms.elements.jv-home-editorial.config.moveDown') }}
							</mt-button>
							<mt-button size="small" variant="critical" @click="removeSectionParagraph(section, paragraphIndex)">
								{{ $t('cms.elements.jv-home-editorial.config.remove') }}
							</mt-button>
						</div>
					</div>

					<sw-text-editor
						v-model:value="section.paragraphs[paragraphIndex]"
						:placeholder="$t('cms.elements.jv-home-editorial.config.paragraph.placeholder')"
						:error="cmsValidationFieldError(`sections.${sectionIndex}.paragraphs.${paragraphIndex}`)"
						@update:value="onUpdate"
					/>
				</div>
			</div>
		</div>

		<div class="sw-cms-el-config-jv-home-editorial__section sw-cms-el-config-jv-home-editorial__labels">
			<h4>{{ $t('cms.elements.jv-home-editorial.config.labels.title') }}</h4>
			<mt-text-field
				v-model:model-value="element.config.showMoreLabel.value"
				:label="$t('cms.elements.jv-home-editorial.config.showMoreLabel.label')"
				:placeholder="$t('cms.elements.jv-home-editorial.config.showMoreLabel.placeholder')"
				@update:model-value="onUpdate"
			/>
			<mt-text-field
				v-model:model-value="element.config.showLessLabel.value"
				:label="$t('cms.elements.jv-home-editorial.config.showLessLabel.label')"
				:placeholder="$t('cms.elements.jv-home-editorial.config.showLessLabel.placeholder')"
				@update:model-value="onUpdate"
			/>
		</div>
	</div>
{% endblock %}
