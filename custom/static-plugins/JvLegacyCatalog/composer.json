{
    "name": "jvmoebel/legacy-catalog",
    "description": "Archive and read-only browser for legacy CosmoShop categories",
    "type": "shopware-platform-plugin",
    "license": "proprietary",
    "version": "0.1.0",
    "require": {
        "php": "^8.5",
        "shopware/core": "~6.7.0"
    },
    "autoload": {
        "psr-4": {
            "Jv\\LegacyCatalog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jv\\LegacyCatalog\\Tests\\": "tests/"
        }
    },
    "extra": {
        "shopware-plugin-class": "Jv\\LegacyCatalog\\JvLegacyCatalog",
        "label": {
            "de-DE": "JVMöbel Legacy-Katalog",
            "en-GB": "JVMöbel legacy catalog"
        }
    }
}
