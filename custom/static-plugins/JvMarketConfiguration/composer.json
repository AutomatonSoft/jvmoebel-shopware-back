{
    "name": "jvmoebel/market-configuration",
    "description": "JVMöbel market and sales channel configuration",
    "type": "shopware-platform-plugin",
    "license": "proprietary",
    "version": "0.1.0",
    "require": {
        "php": "^8.4",
        "shopware/core": "~6.7.0"
