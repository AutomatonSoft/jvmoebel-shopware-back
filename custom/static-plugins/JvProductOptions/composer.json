{
    "name": "jvmoebel/product-options",
    "description": "JVMöbel product option templates with price surcharges",
    "type": "shopware-platform-plugin",
    "license": "proprietary",
    "version": "0.1.0",
    "require": {
        "php": "^8.5",
        "shopware/core": "~6.7.0"
    },
    "autoload": {
        "psr-4": {
            "Jv\\ProductOptions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jv\\ProductOptions\\Tests\\": "tests/"
        }
    },
    "extra": {
        "shopware-plugin-class": "Jv\\ProductOptions\\JvProductOptions",
        "label": {
            "de-DE": "JVMöbel Produktoptionen",
            "en-GB": "JVMöbel Product Options"
        }
    }
}
