{% block sw_cms_el_config_jv_newsletter %}
	<div class="sw-cms-el-config-jv-newsletter">
		<mt-text-field
			v-model:model-value="element.config.title.value"
			:label="$t('cms.elements.jv-newsletter.config.title.label')"
			:placeholder="$t('cms.elements.jv-newsletter.config.title.placeholder')"
			@update:model-value="onUpdate"
		/>

		<mt-text-field
			v-model:model-value="element.config.eyebrow.value"
			:label="$t('cms.elements.jv-newsletter.config.eyebrow.label')"
			:placeholder="$t('cms.elements.jv-newsletter.config.eyebrow.placeholder')"
			class="sw-cms-el-config-jv-newsletter__field"
			@update:model-value="onUpdate"
		/>

		<mt-textarea
			v-model:model-value="element.config.description.value"
			:label="$t('cms.elements.jv-newsletter.config.description.label')"
			:placeholder="$t('cms.elements.jv-newsletter.config.description.placeholder')"
			class="sw-cms-el-config-jv-newsletter__field"
			@update:model-value="onUpdate"
		/>

		<mt-text-field
			v-model:model-value="element.config.buttonLabel.value"
			:label="$t('cms.elements.jv-newsletter.config.buttonLabel.label')"
			:placeholder="$t('cms.elements.jv-newsletter.config.buttonLabel.placeholder')"
			class="sw-cms-el-config-jv-newsletter__field"
			@update:model-value="onUpdate"
		/>

		<mt-select
			v-model:model-value="element.config.buttonSize.value"
			:label="$t('cms.elements.jv-newsletter.config.buttonSize.label')"
			:options="sizeOptions"
			class="sw-cms-el-config-jv-newsletter__field"
			@update:model-value="onUpdate"
		/>

		<mt-text-field
			v-model:model-value="element.config.placeholder.value"
			:label="$t('cms.elements.jv-newsletter.config.placeholder.label')"
			:placeholder="$t('cms.elements.jv-newsletter.config.placeholder.placeholder')"
			class="sw-cms-el-config-jv-newsletter__field"
			@update:model-value="onUpdate"
		/>

		<mt-text-field
			v-model:model-value="element.config.storefrontUrl.value"
			:label="$t('cms.elements.jv-newsletter.config.storefrontUrl.label')"
			:placeholder="$t('cms.elements.jv-newsletter.config.storefrontUrl.placeholder')"
			:help-text="$t('cms.elements.jv-newsletter.config.storefrontUrl.helpText')"
			class="sw-cms-el-config-jv-newsletter__field"
			@update:model-value="onUpdate"
		/>

		<mt-text-field
			v-model:model-value="element.config.successMessage.value"
			:label="$t('cms.elements.jv-newsletter.config.successMessage.label')"
			:placeholder="$t('cms.elements.jv-newsletter.config.successMessage.placeholder')"
			class="sw-cms-el-config-jv-newsletter__field"
			@update:model-value="onUpdate"
		/>

		<mt-text-field
			v-model:model-value="element.config.invalidEmailMessage.value"
			:label="$t('cms.elements.jv-newsletter.config.invalidEmailMessage.label')"
			:placeholder="$t('cms.elements.jv-newsletter.config.invalidEmailMessage.placeholder')"
			class="sw-cms-el-config-jv-newsletter__field"
			@update:model-value="onUpdate"
		/>

		<mt-text-field
			v-model:model-value="element.config.errorMessage.value"
			:label="$t('cms.elements.jv-newsletter.config.errorMessage.label')"
			:placeholder="$t('cms.elements.jv-newsletter.config.errorMessage.placeholder')"
			class="sw-cms-el-config-jv-newsletter__field"
			@update:model-value="onUpdate"
		/>
	</div>
{% endblock %}
