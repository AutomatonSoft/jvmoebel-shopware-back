<div class="jv-catalog-category-attributes">
    <sw-loader v-if="isMappingLoading || isLoading" />

    <template v-else-if="isSourceCategoryGroup">
        <sw-card
            :title="$t('jv-catalog-category-attributes.mappings.title')"
            :subtitle="$t('jv-catalog-category-attributes.mappings.description')"
        >
            <template #headerRight>
                <mt-button
                    variant="primary"
                    :disabled="!canEditMappings || availableMappings.length === 0"
                    @click="openAttributeCreator"
                >
                    {{ $t('jv-catalog-category-attributes.actions.add') }}
                </mt-button>
            </template>

            <sw-data-grid
                v-if="usedMappings.length > 0"
                :data-source="usedMappings"
                :columns="mappingColumns"
                :show-selection="false"
                :show-actions="true"
                identifier="jv-catalog-category-attributes"
            >
                <template #column-usage="{ item }">
                    {{ usageLabel(item) }}
                </template>

                <template #column-target="{ item }">
                    {{ targetLabel(item) }}
                </template>

                <template #actions="{ item }">
                    <sw-context-menu-item
                        :disabled="!canEditMappings"
                        @click="openMappingEditor(item)"
                    >
                        {{ $t('jv-catalog-category-attributes.actions.edit') }}
                    </sw-context-menu-item>
                    <sw-context-menu-item
                        v-if="isConnected(item)"
                        variant="danger"
                        :disabled="!canEditMappings || savingMappingId === item.id"
                        @click="disconnectMapping(item)"
                    >
                        {{ $t('jv-catalog-category-attributes.actions.remove') }}
                    </sw-context-menu-item>
                </template>
            </sw-data-grid>

            <mt-empty-state
                v-else
                icon="regular-tag"
                :headline="$t('jv-catalog-category-attributes.mappings.empty.title')"
                :description="$t('jv-catalog-category-attributes.mappings.empty.description')"
            />
        </sw-card>

        <sw-modal
            v-if="editableMapping"
            :title="editorTitle"
            @modal-close="closeMappingEditor"
        >
            <sw-single-select
                v-if="isAddingMapping"
                v-model:value="editableMapping.id"
                :label="$t('jv-catalog-category-attributes.editor.sourceAttribute')"
                :options="sourceAttributeOptions"
                @update:value="selectSourceAttribute"
            />

            <sw-single-select
                v-model:value="editableMapping.storage"
                :label="$t('jv-catalog-category-attributes.editor.usage')"
                :options="storageOptions"
                @update:value="onEditorStorageChange"
            />

            <sw-entity-single-select
                v-if="editableMapping.storage === 'property'"
                v-model:value="editableMapping.propertyGroupId"
                entity="property_group"
                :label="$t('jv-catalog-category-attributes.editor.target')"
                :placeholder="$t('jv-catalog-category-attributes.target.selectProperty')"
            />

            <p
                v-else-if="editableMapping.storage === 'custom_field'"
            >
                {{ $t('jv-catalog-category-attributes.editor.productInformation') }}
            </p>

            <template #modal-footer>
                <mt-button variant="secondary" @click="closeMappingEditor">
                    {{ $t('global.default.cancel') }}
                </mt-button>
                <mt-button
                    variant="primary"
                    :disabled="editableMapping.storage === 'property' && !editableMapping.propertyGroupId"
                    :is-loading="savingMappingId === editableMapping.id"
                    @click="saveEditedMapping"
                >
                    {{ $t('jv-catalog-category-attributes.actions.save') }}
                </mt-button>
            </template>
        </sw-modal>
    </template>

    <mt-empty-state
        v-else
        icon="regular-folder-open"
        :headline="$t('jv-catalog-category-attributes.notSourceGroup.title')"
        :description="$t('jv-catalog-category-attributes.notSourceGroup.description')"
    />
</div>
