<sw-page class="jv-option-template-detail">
    <template #smart-bar-header>
        <h2>{{ identifier }}</h2>
    </template>

    <template #smart-bar-actions>
        <sw-button
            :disabled="isLoading"
            @click="onCancel"
        >
            {{ $t('jv-option-template.detail.buttonCancel') }}
        </sw-button>

        <sw-button
            variant="primary"
            :disabled="isLoading"
            @click="onSave"
        >
            {{ $t('jv-option-template.detail.buttonSave') }}
        </sw-button>
    </template>

    <template #content>
        <sw-card-view v-if="templateEntity">
            <sw-card
                position-identifier="jv-option-template-general"
                :title="$t('jv-option-template.detail.cardGeneral')"
                :is-loading="isLoading"
            >
                <sw-container columns="2fr 1fr 1fr" gap="16px">
                    <sw-text-field
                        v-model:value="templateEntity.name"
                        required
                        :label="$t('jv-option-template.detail.labelName')"
                        :placeholder="$t('jv-option-template.detail.placeholderName')"
                    />

                    <mt-number-field
                        v-model="templateEntity.priority"
                        :label="$t('jv-option-template.detail.labelPriority')"
                        number-type="int"
                        :step="1"
                    />

                    <sw-switch-field
                        v-model:value="templateEntity.active"
                        :label="$t('jv-option-template.detail.labelActive')"
                    />
                </sw-container>

                <sw-container columns="1fr" gap="16px" style="margin-top: 16px;">
                    <sw-entity-many-to-many-select
                        v-if="templateEntity.productStreams"
                        :entity-collection="templateEntity.productStreams"
                        label-property="name"
                        :label="$t('jv-option-template.detail.labelProductStreams')"
                        :placeholder="$t('jv-option-template.detail.placeholderProductStreams')"
                    />
                </sw-container>
            </sw-card>

            <sw-card
                position-identifier="jv-option-template-groups"
                :title="$t('jv-option-template.detail.cardGroups')"
                :is-loading="isLoading"
            >
                <template #grid>
                    <div style="padding: 16px;">
                        <sw-button
                            variant="ghost"
                            size="small"
                            style="margin-bottom: 16px;"
                            @click="addGroup"
                        >
                            <sw-icon name="regular-plus-xs" size="12px" />
                            {{ $t('jv-option-template.detail.buttonAddGroup') }}
                        </sw-button>

                        <div v-if="groups.length === 0" style="color: #999; font-style: italic; padding: 16px 0;">
                            {{ $t('jv-option-template.detail.emptyGroups') }}
                        </div>

                        <div
                            v-for="(group, groupIndex) in groups"
                            :key="group.id"
                            class="jv-option-template-group"
                        >
                            <sw-container class="jv-option-template-group__header" columns="minmax(220px, 2fr) 120px minmax(220px, 2fr) 44px" gap="16px" align="end">
                                <sw-text-field
                                    v-model:value="group.name"
                                    required
                                    :label="$t('jv-option-template.detail.labelGroupName')"
                                    :placeholder="$t('jv-option-template.detail.placeholderGroupName')"
                                />

                                <mt-number-field
                                    v-model="group.position"
                                    :label="$t('jv-option-template.detail.labelGroupPosition')"
                                    number-type="int"
                                    :step="1"
                                />

                                <sw-single-select
                                    v-model:value="group.defaultValueId"
                                    :options="group.values.map((v) => ({ value: v.id, label: v.name || v.id }))"
                                    :label="$t('jv-option-template.detail.labelDefaultValue')"
                                    :placeholder="$t('jv-option-template.detail.placeholderDefaultValue')"
                                    show-clearable-button
                                />

                                <sw-button
                                    variant="danger"
                                    square
                                    size="small"
                                    @click="removeGroup(groupIndex)"
                                >
                                    <sw-icon name="regular-trash" size="16px" />
                                </sw-button>
                            </sw-container>

                            <div class="jv-option-template-group__palette">
                                <label class="jv-option-template-media-field__label">
                                    {{ $t('jv-option-template.detail.labelGroupPaletteMedia') }}
                                </label>
                                <sw-media-upload-v2
                                    variant="regular"
                                    :upload-tag="mediaUploadTag('group', group.id)"
                                    :source="mediaPreviewSource(group.paletteMediaId)"
                                    :allow-multi-select="false"
                                    :caption="$t('jv-option-template.detail.captionGroupPaletteMedia')"
                                    @media-upload-sidebar-open="openGroupPaletteMediaModal(group.id)"
                                    @media-upload-remove-image="onGroupPaletteMediaRemove(group)"
                                />
                                <sw-upload-listener
                                    :upload-tag="mediaUploadTag('group', group.id)"
                                    auto-upload
                                    @media-upload-finish="onGroupPaletteMediaUpload(group, $event)"
                                />
                                <p class="jv-option-template-media-field__help">
                                    {{ $t('jv-option-template.detail.helpGroupPaletteMedia') }}
                                </p>
                            </div>

                            <div class="jv-option-template-group__values">
                                <div class="jv-option-template-group__values-header">
                                    <h4>{{ $t('jv-option-template.detail.valuesTitle') }} ({{ group.values.length }})</h4>
                                    <sw-button
                                        size="x-small"
                                        variant="ghost"
                                        @click="addValue(group)"
                                    >
                                        <sw-icon name="regular-plus-xs" size="10px" />
                                        {{ $t('jv-option-template.detail.buttonAddValue') }}
                                    </sw-button>
                                </div>

                                <div v-if="group.values.length === 0" class="jv-option-template-group__empty-values">
                                    {{ $t('jv-option-template.detail.emptyValues') }}
                                </div>

                                <div
                                    v-for="(val, valIndex) in group.values"
                                    :key="val.id"
                                    class="jv-option-template-value"
                                >
                                    <sw-container class="jv-option-template-value__header" columns="100px minmax(240px, 2fr) minmax(220px, 1fr) 44px" gap="16px" align="end">
                                        <mt-number-field
                                            v-model="val.position"
                                            :label="$t('jv-option-template.detail.labelValuePosition')"
                                            size="small"
                                            number-type="int"
                                        />

                                        <sw-text-field
                                            v-model:value="val.name"
                                            required
                                            :label="$t('jv-option-template.detail.labelValueName')"
                                            :placeholder="$t('jv-option-template.detail.placeholderValueName')"
                                            size="small"
                                        />

                                        <sw-single-select
                                            v-model:value="val.surchargeType"
                                            :options="surchargeTypeOptions"
                                            :label="$t('jv-option-template.detail.labelValueSurchargeType')"
                                        />

                                        <sw-button
                                            variant="danger"
                                            square
                                            size="x-small"
                                            @click="removeValue(group, valIndex)"
                                        >
                                            <sw-icon name="regular-trash" size="14px" />
                                        </sw-button>
                                    </sw-container>

                                    <sw-container class="jv-option-template-value__visuals" columns="minmax(220px, 1fr) minmax(280px, 1.4fr)" gap="16px">
                                        <mt-colorpicker
                                            v-model="val.colorHex"
                                            :label="$t('jv-option-template.detail.labelValueColorHex')"
                                            :alpha="false"
                                        />

                                        <div class="jv-option-template-media-field">
                                            <label class="jv-option-template-media-field__label">
                                                {{ $t('jv-option-template.detail.labelValueMedia') }}
                                            </label>
                                            <sw-media-upload-v2
                                                variant="regular"
                                                :upload-tag="mediaUploadTag('value', group.id, val.id)"
                                                :source="mediaPreviewSource(val.mediaId)"
                                                :allow-multi-select="false"
                                                :caption="$t('jv-option-template.detail.captionValueMedia')"
                                                @media-upload-sidebar-open="openValueMediaModal(group.id, val.id)"
                                                @media-upload-remove-image="onValueMediaRemove(val)"
                                            />
                                            <sw-upload-listener
                                                :upload-tag="mediaUploadTag('value', group.id, val.id)"
                                                auto-upload
                                                @media-upload-finish="onValueMediaUpload(val, $event)"
                                            />
                                            <p class="jv-option-template-media-field__help">
                                                {{ $t('jv-option-template.detail.helpValueMedia') }}
                                            </p>
                                        </div>
                                    </sw-container>

                                    <div class="jv-option-template-value__surcharge">
                                        <div class="jv-option-template-value__surcharge-title">
                                            {{ $t('jv-option-template.detail.labelValueSurchargePrice') }}
                                            <span>{{ systemCurrencyLabel }}</span>
                                        </div>

                                        <sw-container v-if="val.surchargeType === 'fixed'" columns="minmax(180px, 240px) minmax(180px, 240px)" gap="16px">
                                            <mt-number-field
                                                v-model="val.grossPrice"
                                                :label="$t('jv-option-template.detail.labelValueSurchargeGross')"
                                                :step="0.01"
                                                :digits="2"
                                                :min="0"
                                            />
                                            <mt-number-field
                                                v-model="val.netPrice"
                                                :label="$t('jv-option-template.detail.labelValueSurchargeNet')"
                                                :step="0.01"
                                                :digits="2"
                                                :min="0"
                                            />
                                        </sw-container>

                                        <mt-number-field
                                            v-else
                                            v-model="val.surchargePercentage"
                                            :label="$t('jv-option-template.detail.labelValueSurchargePercentage')"
                                            :step="0.1"
                                            :min="0"
                                            :max="1000"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </template>
            </sw-card>
        </sw-card-view>
    </template>

    <sw-media-modal-v2
        v-if="mediaModalIsOpen"
        :allow-multi-select="false"
        @media-modal-selection-change="onMediaSelectionChanges"
        @media-modal-close="closeMediaModal"
    />
</sw-page>
