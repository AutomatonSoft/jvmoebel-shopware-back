{% block jv_seo_landing_page_redirects %}
<mt-card
    v-if="acl.can('jv_seo_redirect:read')"
    position-identifier="jv-seo-landing-page-redirects"
    :title="$t('jv-seo.landingPageCard.title')"
    :is-loading="isLoading"
>
    <template #toolbar>
        <mt-button
            v-if="acl.can(redirectId ? 'jv_seo_redirect:update' : 'jv_seo_redirect:create')"
            size="small"
            variant="secondary"
            @click="$router.push(redirectId
                ? { name: 'jv.seo.detail', params: { id: redirectId } }
                : { name: 'jv.seo.create', query: { landingPageId } })"
        >
            {{ redirectId ? $t('global.default.edit') : $t('jv-seo.actions.create') }}
        </mt-button>
    </template>

    <sw-data-grid
        v-if="rows.length"
        :data-source="rows"
        :columns="columns"
        :show-selection="false"
        :show-settings="false"
        :show-actions="false"
    >
        <template #column-targetUrl="{ item }">
            <span v-if="item.targetUrl">{{ item.targetUrl }}</span>
            <span v-else>{{ $t('jv-seo.detail.targetUnavailable') }}</span>
        </template>
        <template #column-sources="{ item }">
            <ul class="jv-seo-landing-page-redirects__sources">
                <li v-for="sourceUrl in item.sourceUrls" :key="sourceUrl">{{ sourceUrl }}</li>
            </ul>
        </template>
    </sw-data-grid>

    <mt-empty-state
        v-else-if="!isLoading"
        icon="regular-link"
        :headline="$t('jv-seo.landingPageCard.empty')"
    />
</mt-card>
{% endblock %}
