{% block sw_cms_el_config_jv_countdown_promo %}
	<div class="sw-cms-el-config-jv-countdown-promo">
		<mt-text-field
			v-model:model-value="element.config.title.value"
			:label="$t('cms.elements.jv-countdown-promo.config.title.label')"
			:placeholder="$t('cms.elements.jv-countdown-promo.config.title.placeholder')"
			@update:model-value="onUpdate"
		/>

		<mt-text-field
			v-model:model-value="element.config.eyebrow.value"
			:label="$t('cms.elements.jv-countdown-promo.config.eyebrow.label')"
			:placeholder="$t('cms.elements.jv-countdown-promo.config.eyebrow.placeholder')"
			@update:model-value="onUpdate"
		/>

		<mt-textarea
			v-model:model-value="element.config.description.value"
			:label="$t('cms.elements.jv-countdown-promo.config.description.label')"
			:placeholder="$t('cms.elements.jv-countdown-promo.config.description.placeholder')"
			@update:model-value="onUpdate"
		/>

		<mt-text-field
			v-model:model-value="element.config.endsAt.value"
			:label="$t('cms.elements.jv-countdown-promo.config.endsAt.label')"
			:placeholder="$t('cms.elements.jv-countdown-promo.config.endsAt.placeholder')"
			:help-text="$t('cms.elements.jv-countdown-promo.config.endsAt.helpText')"
			@update:model-value="onUpdate"
		/>

		<mt-text-field
			v-model:model-value="element.config.promoCode.value"
			:label="$t('cms.elements.jv-countdown-promo.config.promoCode.label')"
			:placeholder="$t('cms.elements.jv-countdown-promo.config.promoCode.placeholder')"
			@update:model-value="onUpdate"
		/>

		<div class="sw-cms-el-config-jv-countdown-promo__section">
			<h4>{{ $t('cms.elements.jv-countdown-promo.config.link.title') }}</h4>

			<mt-text-field
				v-model:model-value="element.config.link.value.label"
				:label="$t('cms.elements.jv-countdown-promo.config.link.label.label')"
				:placeholder="$t('cms.elements.jv-countdown-promo.config.link.label.placeholder')"
				@update:model-value="onUpdate"
			/>

			<mt-text-field
				v-model:model-value="element.config.link.value.url"
				:label="$t('cms.elements.jv-countdown-promo.config.link.url.label')"
				:placeholder="$t('cms.elements.jv-countdown-promo.config.link.url.placeholder')"
				@update:model-value="onUpdate"
			/>

			<mt-select
				v-model:model-value="element.config.link.value.size"
				:label="$t('cms.elements.jv-countdown-promo.config.link.size.label')"
				:options="sizeOptions"
				@update:model-value="onUpdate"
			/>
		</div>
	</div>
{% endblock %}
