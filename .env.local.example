# Template for the ignored .env.local generated by bin/setup-local.
# Service names below resolve only inside the local Compose network.
APP_ENV=dev
APP_DEBUG=1
APP_URL=http://localhost:8000
APP_SECRET=

INSTANCE_ID=
BLUE_GREEN_DEPLOYMENT=0
COMPOSER_HOME=/tmp/composer
LOCK_DSN=flock

HOST=0.0.0.0
DATABASE_URL=mysql://root:root@database:3306/shopware

MAILER_DSN=smtp://mailer:1025

MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages
MESSENGER_TRANSPORT_LOW_PRIORITY_DSN=redis://redis:6379/low_priority
MESSENGER_TRANSPORT_FAILURE_DSN=redis://redis:6379/failed

TRUSTED_PROXIES=REMOTE_ADDR
SYMFONY_TRUSTED_PROXIES=REMOTE_ADDR
OPENSEARCH_URL=http://opensearch:9200
ADMIN_OPENSEARCH_URL=http://opensearch:9200

SHOPWARE_ES_ENABLED=1
SHOPWARE_ES_INDEXING_ENABLED=1
SHOPWARE_ES_INDEX_PREFIX=sw
SHOPWARE_ES_THROW_EXCEPTION=1
SHOPWARE_HTTP_CACHE_ENABLED=0

PHP_IDE_CONFIG=serverName=jvmoebel-shopware-back
PHP_MAX_UPLOAD_SIZE=

# Sales channel domain URL template. Identity (UUID seed) stays the domain string; only the URL is env-specific.
JV_MARKET_SALES_CHANNEL_URL_TEMPLATE=https://{domain}

# Private Next sitemap ingestion. Keep the real secret only in ignored .env.local.
JV_SITEMAP_INGESTION_ENDPOINT=http://frontend:3000
JV_SITEMAP_INGESTION_SECRET=
JV_SITEMAP_INGESTION_TIMEOUT=20
JV_SITEMAP_PUBLICATION_ENVIRONMENT=local

# Aftercool product import. Keep credentials only in the ignored .env.local.
AFTERCOOL_BASE_URI=https://aftercool.de
AFTERCOOL_USERNAME=
AFTERCOOL_PASSWORD=
AFTERCOOL_TIMEOUT=20

MYSQL_DATABASE=shopware
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=shopware
MYSQL_PASSWORD=shopware
