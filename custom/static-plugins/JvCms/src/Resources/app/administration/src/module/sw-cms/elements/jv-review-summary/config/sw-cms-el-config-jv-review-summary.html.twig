{% block sw_cms_el_config_jv_review_summary %}
	<div class="sw-cms-el-config-jv-review-summary">
		<mt-textarea
			v-model:model-value="element.config.summary.value"
			:label="$t('cms.elements.jv-review-summary.config.summary.label')"
			@update:model-value="onUpdate"
		/>

		<mt-text-field
			v-model:model-value="element.config.sourceLabel.value"
			:label="$t('cms.elements.jv-review-summary.config.sourceLabel.label')"
			@update:model-value="onUpdate"
		/>

		<mt-number-field
			v-model:model-value="element.config.rating.value"
			:label="$t('cms.elements.jv-review-summary.config.rating.label')"
			:help-text="$t('cms.elements.jv-review-summary.config.rating.helpText')"
			:min="0.1"
			:max="5"
			:step="0.1"
			@update:model-value="onUpdate"
		/>
	</div>
{% endblock %}
