{% block sw_cms_element_jv_social_block %}
	<div class="sw-cms-el-jv-social-block">
		<h2 class="sw-cms-el-jv-social-block__title">
			{{ title || $t('cms.elements.jv-social-block.component.titlePlaceholder') }}
		</h2>

		<div v-if="items.length" class="sw-cms-el-jv-social-block__items">
			<div
				v-for="(item, itemIndex) in items"
				:key="itemKey(item, itemIndex)"
				class="sw-cms-el-jv-social-block__item"
			>
				<img
					v-if="itemImageUrl(item, itemIndex)"
					:src="itemImageUrl(item, itemIndex)"
					alt=""
				>
				<div v-else class="sw-cms-el-jv-social-block__image-placeholder">
					{{ item.name.slice(0, 1).toUpperCase() || 'S' }}
				</div>
				<span>{{ item.name || $t('cms.elements.jv-social-block.component.itemPlaceholder', { index: itemIndex + 1 }) }}</span>
			</div>
		</div>
		<div v-else class="sw-cms-el-jv-social-block__empty">
			{{ $t('cms.elements.jv-social-block.component.noItems') }}
		</div>
	</div>
{% endblock %}
