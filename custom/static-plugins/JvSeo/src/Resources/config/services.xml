<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults autowire="true" autoconfigure="true" public="false"/>

        <service id="Jv\Seo\Core\Content\Redirect\RedirectDefinition">
            <tag name="shopware.entity.definition" entity="jv_seo_redirect"/>
        </service>
        <service id="Jv\Seo\Core\Content\RedirectChannel\RedirectChannelDefinition">
            <tag name="shopware.entity.definition" entity="jv_seo_redirect_channel"/>
        </service>
        <service id="Jv\Seo\Core\Content\RedirectSource\RedirectSourceDefinition">
            <tag name="shopware.entity.definition" entity="jv_seo_redirect_source"/>
        </service>
        <service id="Jv\Seo\Core\Content\SitemapExportRun\SitemapExportRunDefinition">
            <tag name="shopware.entity.definition" entity="jv_seo_sitemap_export_run"/>
        </service>
        <service id="Jv\Seo\Core\Content\RobotsPublicationRun\RobotsPublicationRunDefinition">
            <tag name="shopware.entity.definition" entity="jv_seo_robots_publication_run"/>
        </service>

        <service id="Jv\Seo\Service\Redirect\UrlNormalizer"/>
        <service id="Jv\Seo\Service\Redirect\ProductTargetUrlResolver">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>
        <service id="Jv\Seo\Service\Redirect\CategoryTargetUrlResolver">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>
        <service id="Jv\Seo\Service\Redirect\LandingPageTargetUrlResolver">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>
        <service id="Jv\Seo\Service\Redirect\ImageTargetUrlResolver">
            <argument type="service" id="media.repository"/>
            <argument type="service" id="Jv\Seo\Service\Redirect\UrlNormalizer"/>
        </service>
        <service id="Jv\Seo\Service\Redirect\ImportProductRedirectsService">
            <argument type="service" id="jv_seo_redirect.repository"/>
            <argument type="service" id="jv_seo_redirect_channel.repository"/>
            <argument type="service" id="jv_seo_redirect_source.repository"/>
            <argument type="service" id="Jv\Seo\Service\Redirect\UrlNormalizer"/>
        </service>
        <service id="Jv\Seo\Contract\ImportProductRedirectsInterface" alias="Jv\Seo\Service\Redirect\ImportProductRedirectsService"/>
        <service id="Jv\Seo\Service\Redirect\ImportImageRedirectsService">
            <argument type="service" id="jv_seo_redirect.repository"/>
            <argument type="service" id="jv_seo_redirect_channel.repository"/>
            <argument type="service" id="jv_seo_redirect_source.repository"/>
            <argument type="service" id="Jv\Seo\Service\Redirect\UrlNormalizer"/>
            <argument type="service" id="Jv\Seo\Service\Redirect\ImageTargetUrlResolver"/>
        </service>
        <service id="Jv\Seo\Contract\ImportImageRedirectsInterface" alias="Jv\Seo\Service\Redirect\ImportImageRedirectsService"/>
        <service id="Jv\Seo\Service\Redirect\SaveRedirectService">
            <argument type="service" id="jv_seo_redirect.repository"/>
            <argument type="service" id="jv_seo_redirect_channel.repository"/>
            <argument type="service" id="jv_seo_redirect_source.repository"/>
            <argument type="service" id="product.repository"/>
            <argument type="service" id="category.repository"/>
            <argument type="service" id="landing_page.repository"/>
            <argument type="service" id="media.repository"/>
            <argument type="service" id="sales_channel.repository"/>
            <argument type="service" id="Jv\Seo\Service\Redirect\UrlNormalizer"/>
            <argument type="service" id="Jv\Seo\Service\Redirect\ProductTargetUrlResolver"/>
            <argument type="service" id="Jv\Seo\Service\Redirect\CategoryTargetUrlResolver"/>
            <argument type="service" id="Jv\Seo\Service\Redirect\LandingPageTargetUrlResolver"/>
            <argument type="service" id="Jv\Seo\Service\Redirect\ImageTargetUrlResolver"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>
        <service id="Jv\Seo\Service\Redirect\RedirectQueryService">
            <argument type="service" id="jv_seo_redirect.repository"/>
            <argument type="service" id="sales_channel.repository"/>
            <argument type="service" id="Jv\Seo\Service\Redirect\ProductTargetUrlResolver"/>
            <argument type="service" id="Jv\Seo\Service\Redirect\CategoryTargetUrlResolver"/>
            <argument type="service" id="Jv\Seo\Service\Redirect\LandingPageTargetUrlResolver"/>
            <argument type="service" id="Jv\Seo\Service\Redirect\ImageTargetUrlResolver"/>
        </service>
        <service id="Jv\Seo\Service\Redirect\LookupRedirectService">
            <argument type="service" id="jv_seo_redirect_source.repository"/>
            <argument type="service" id="Jv\Seo\Service\Redirect\UrlNormalizer"/>
            <argument type="service" id="Jv\Seo\Service\Redirect\ProductTargetUrlResolver"/>
            <argument type="service" id="Jv\Seo\Service\Redirect\CategoryTargetUrlResolver"/>
            <argument type="service" id="Jv\Seo\Service\Redirect\LandingPageTargetUrlResolver"/>
            <argument type="service" id="Jv\Seo\Service\Redirect\ImageTargetUrlResolver"/>
        </service>
        <service id="Jv\Seo\Service\CategoryMapping\CategoryMappingScoreCalculator"/>
        <service id="Jv\Seo\Service\CategoryMapping\ExportLegacyCategoryMappingCsvService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Jv\Seo\Service\CategoryMapping\CategoryMappingScoreCalculator"/>
        </service>
        <service id="Jv\Seo\Command\ExportLegacyCategoryMappingCommand">
            <argument type="service" id="Jv\Seo\Service\CategoryMapping\ExportLegacyCategoryMappingCsvService"/>
            <argument type="service" id="logger"/>
            <argument key="$environment">%kernel.environment%</argument>
        </service>

        <service id="Jv\Seo\Service\Sitemap\LegacyRedirectCustomUrlProvider" decorates="Shopware\Core\Content\Sitemap\Provider\CustomUrlProvider">
            <argument type="service" id="Jv\Seo\Service\Sitemap\LegacyRedirectCustomUrlProvider.inner"/>
            <argument type="service" id="Jv\Seo\Service\Redirect\LookupRedirectService"/>
        </service>
        <service id="Jv\Seo\Service\Sitemap\SitemapArtifactCollector">
            <argument type="service" id="Shopware\Core\Content\Sitemap\Service\SitemapLister"/>
            <argument type="service" id="shopware.filesystem.sitemap"/>
        </service>
        <service id="Jv\Seo\Service\Sitemap\EligibleSitemapSalesChannels">
            <argument type="service" id="sales_channel.repository"/>
        </service>
        <service id="Jv\Seo\Service\Sitemap\SitemapExportRunStore">
            <argument type="service" id="jv_seo_sitemap_export_run.repository"/>
        </service>
        <service id="Jv\Seo\Service\Robots\RobotsPublicationRunStore">
            <argument type="service" id="jv_seo_robots_publication_run.repository"/>
        </service>
        <service id="Jv\Seo\Service\Robots\RobotsTextValidator"/>
        <service id="Jv\Seo\Service\Robots\StartRobotsPublicationService">
            <argument type="service" id="Jv\Seo\Service\Sitemap\EligibleSitemapSalesChannels"/>
            <argument type="service" id="Jv\Seo\Service\Robots\RobotsTextValidator"/>
            <argument type="service" id="Jv\Seo\Service\Robots\RobotsPublicationRunStore"/>
            <argument type="service" id="messenger.default_bus"/>
            <argument type="service" id="lock.factory"/>
        </service>
        <service id="Jv\Seo\Integration\NextRobots\NextRobotsPublisher">
            <argument type="service" id="http_client"/>
            <argument type="service" id="shopware.filesystem.sitemap"/>
            <argument>%env(string:JV_SITEMAP_INGESTION_ENDPOINT)%</argument>
            <argument>%env(string:JV_SITEMAP_INGESTION_SECRET)%</argument>
            <argument>%env(float:JV_SITEMAP_INGESTION_TIMEOUT)%</argument>
            <argument>%env(string:JV_SITEMAP_PUBLICATION_ENVIRONMENT)%</argument>
        </service>
        <service id="Jv\Seo\Service\Robots\Contract\RobotsPublisherInterface" alias="Jv\Seo\Integration\NextRobots\NextRobotsPublisher"/>
        <service id="Jv\Seo\Service\Robots\GenerateAndPublishRobotsService">
            <argument type="service" id="Jv\Seo\Service\Sitemap\EligibleSitemapSalesChannels"/>
            <argument type="service" id="shopware.filesystem.sitemap"/>
            <argument type="service" id="Jv\Seo\Service\Robots\RobotsPublicationRunStore"/>
            <argument type="service" id="Jv\Seo\Service\Robots\Contract\RobotsPublisherInterface"/>
            <argument type="service" id="Jv\Seo\Service\Robots\RobotsTextValidator"/>
            <argument type="service" id="Psr\Clock\ClockInterface"/>
        </service>
        <service id="Jv\Seo\MessageHandler\RobotsPublicationMessageHandler">
            <argument type="service" id="Jv\Seo\Service\Robots\RobotsPublicationRunStore"/>
            <argument type="service" id="Jv\Seo\Service\Robots\GenerateAndPublishRobotsService"/>
            <argument type="service" id="lock.factory"/>
            <argument type="service" id="logger"/>
        </service>
        <service id="Jv\Seo\Integration\NextSitemap\NextSitemapPublisher">
            <argument type="service" id="http_client"/>
            <argument type="service" id="shopware.filesystem.sitemap"/>
            <argument>%env(string:JV_SITEMAP_INGESTION_ENDPOINT)%</argument>
            <argument>%env(string:JV_SITEMAP_INGESTION_SECRET)%</argument>
            <argument>%env(float:JV_SITEMAP_INGESTION_TIMEOUT)%</argument>
            <argument>%env(string:JV_SITEMAP_PUBLICATION_ENVIRONMENT)%</argument>
        </service>
        <service id="Jv\Seo\Service\Sitemap\Contract\SitemapPublisherInterface" alias="Jv\Seo\Integration\NextSitemap\NextSitemapPublisher"/>
        <service id="Jv\Seo\Service\Sitemap\SitemapGenerationLock">
            <argument type="service" id="lock.factory"/>
        </service>
        <service id="Jv\Seo\Service\Sitemap\CoordinatedSitemapExporter" decorates="Shopware\Core\Content\Sitemap\Service\SitemapExporter">
            <argument type="service" id="Jv\Seo\Service\Sitemap\CoordinatedSitemapExporter.inner"/>
            <argument type="service" id="Jv\Seo\Service\Sitemap\SitemapGenerationLock"/>
        </service>
        <service id="Jv\Seo\Service\Sitemap\GenerateAndPublishSitemapService">
            <argument type="service" id="Jv\Seo\Service\Sitemap\EligibleSitemapSalesChannels"/>
            <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextFactory"/>
            <argument type="service" id="Jv\Seo\Service\Sitemap\CoordinatedSitemapExporter.inner"/>
            <argument type="service" id="Jv\Seo\Service\Sitemap\SitemapArtifactCollector"/>
            <argument type="service" id="Jv\Seo\Service\Sitemap\Contract\SitemapPublisherInterface"/>
            <argument type="service" id="Jv\Seo\Service\Sitemap\SitemapGenerationLock"/>
            <argument type="service" id="Jv\Seo\Service\Sitemap\SitemapExportRunStore"/>
            <argument type="service" id="Psr\Clock\ClockInterface"/>
        </service>
        <service id="Jv\Seo\Service\Sitemap\StartSitemapExportService">
            <argument type="service" id="Jv\Seo\Service\Sitemap\EligibleSitemapSalesChannels"/>
            <argument type="service" id="Jv\Seo\Service\Sitemap\SitemapExportRunStore"/>
            <argument type="service" id="messenger.default_bus"/>
        </service>
        <service id="Jv\Seo\MessageHandler\SitemapExportMessageHandler">
            <argument type="service" id="Jv\Seo\Service\Sitemap\SitemapExportRunStore"/>
            <argument type="service" id="Jv\Seo\Service\Sitemap\GenerateAndPublishSitemapService"/>
            <argument type="service" id="lock.factory"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="Jv\Seo\Controller\RedirectController" public="true">
            <tag name="controller.service_arguments"/>
        </service>
        <service id="Jv\Seo\Controller\SitemapExportController" public="true">
            <argument type="service" id="Jv\Seo\Service\Sitemap\StartSitemapExportService"/>
            <argument type="service" id="Jv\Seo\Service\Sitemap\EligibleSitemapSalesChannels"/>
            <argument type="service" id="jv_seo_sitemap_export_run.repository"/>
            <tag name="controller.service_arguments"/>
        </service>
        <service id="Jv\Seo\Controller\RobotsPublicationController" public="true">
            <argument type="service" id="Jv\Seo\Service\Robots\StartRobotsPublicationService"/>
            <argument type="service" id="Jv\Seo\Service\Sitemap\EligibleSitemapSalesChannels"/>
            <argument type="service" id="Jv\Seo\Service\Robots\RobotsPublicationRunStore"/>
            <argument type="service" id="jv_seo_robots_publication_run.repository"/>
            <tag name="controller.service_arguments"/>
        </service>
        <service id="Jv\Seo\StoreApi\Route\RedirectLookupRoute" public="true">
            <tag name="controller.service_arguments"/>
        </service>
    </services>
</container>
