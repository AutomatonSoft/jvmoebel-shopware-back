#!/usr/bin/env bash

set -euo pipefail

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
compose_file="${project_dir}/compose.deploy.yml"
template_file="${project_dir}/.env.deploy.example"
compose_keys="$(mktemp)"
template_keys="$(mktemp)"
missing_keys="$(mktemp)"

cleanup() {
    rm -f -- "$compose_keys" "$template_keys" "$missing_keys"
}
trap cleanup EXIT

LC_ALL=C grep -oE '\$\{[A-Z][A-Z0-9_]*' "$compose_file" \
    | sed 's/^${//' \
    | sort -u > "$compose_keys"

LC_ALL=C sed -nE 's/^([A-Z][A-Z0-9_]*)=.*/\1/p' "$template_file" \
    | sort -u > "$template_keys"

comm -23 "$compose_keys" "$template_keys" > "$missing_keys"

if [[ -s "$missing_keys" ]]; then
    echo "Deployment env template is missing variables required by compose.deploy.yml:" >&2
    sed 's/^/  - /' "$missing_keys" >&2
    exit 1
fi

docker compose --env-file "$template_file" -f "$compose_file" config --quiet
