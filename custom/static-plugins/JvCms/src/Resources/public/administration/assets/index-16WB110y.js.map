{% block sw_cms_element_jv_chip_rail %}
	<div class="sw-cms-el-jv-chip-rail">
		<strong class="sw-cms-el-jv-chip-rail__title">
			{{ previewTitle }}
		</strong>
		<span class="sw-cms-el-jv-chip-rail__hint">
			{{ $t('cms.elements.jv-chip-rail.component.canvasHint', { count: chipCount }) }}
		</span>
	</div>
{% endblock %}
