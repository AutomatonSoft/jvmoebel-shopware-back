{% block sw_cms_el_config_jv_promo_deal_tiles %}
	<div class="sw-cms-el-config-jv-promo-deal-tiles">
		<mt-text-field
			v-model:model-value="element.config.title.value"
			:label="$t('cms.elements.jv-promo-deal-tiles.config.title.label')"
			:placeholder="$t('cms.elements.jv-promo-deal-tiles.config.title.placeholder')"
			@update:model-value="onUpdate"
		/>

		<mt-text-field
			v-model:model-value="element.config.eyebrow.value"
			:label="$t('cms.elements.jv-promo-deal-tiles.config.eyebrow.label')"
			:placeholder="$t('cms.elements.jv-promo-deal-tiles.config.eyebrow.placeholder')"
			@update:model-value="onUpdate"
		/>

		<div class="sw-cms-el-config-jv-promo-deal-tiles__section">
			<div class="sw-cms-el-config-jv-promo-deal-tiles__section-header">
				<h4>{{ $t('cms.elements.jv-promo-deal-tiles.config.tiles.title') }}</h4>
				<mt-button size="small" variant="secondary" @click="addTile">
					{{ $t('cms.elements.jv-promo-deal-tiles.config.tiles.add') }}
				</mt-button>
			</div>

			<div
				v-for="(tile, tileIndex) in tiles"
				:key="`jv-promo-deal-tiles-${tileIndex}`"
				class="sw-cms-el-config-jv-promo-deal-tiles__card"
			>
				<div class="sw-cms-el-config-jv-promo-deal-tiles__card-header">
					<strong>{{ $t('cms.elements.jv-promo-deal-tiles.config.tiles.cardTitle', { index: tileIndex + 1 }) }}</strong>
					<mt-button size="small" variant="critical" @click="removeTile(tileIndex)">
						{{ $t('cms.elements.jv-promo-deal-tiles.config.tiles.remove') }}
					</mt-button>
				</div>

				<mt-text-field
					v-model:model-value="tile.id"
					:label="$t('cms.elements.jv-promo-deal-tiles.config.tiles.id.label')"
					@update:model-value="onUpdate"
				/>

				<mt-text-field
					v-model:model-value="tile.label"
					:label="$t('cms.elements.jv-promo-deal-tiles.config.tiles.label.label')"
					@update:model-value="onUpdate"
				/>

				<mt-textarea
					v-model:model-value="tile.description"
					:label="$t('cms.elements.jv-promo-deal-tiles.config.tiles.description.label')"
					@update:model-value="onUpdate"
				/>

				<mt-text-field
					v-model:model-value="tile.discountLabel"
					:label="$t('cms.elements.jv-promo-deal-tiles.config.tiles.discountLabel.label')"
					@update:model-value="onUpdate"
				/>

				<mt-text-field
					v-model:model-value="tile.endsAt"
					:label="$t('cms.elements.jv-promo-deal-tiles.config.tiles.endsAt.label')"
					:placeholder="$t('cms.elements.jv-promo-deal-tiles.config.tiles.endsAt.placeholder')"
					@update:model-value="onUpdate"
				/>

				<div class="sw-cms-el-config-jv-promo-deal-tiles__media">
					<label class="sw-cms-el-config-jv-promo-deal-tiles__media-label">
						{{ $t('cms.elements.jv-promo-deal-tiles.config.tiles.imageMedia.label') }}
					</label>

					<sw-media-upload-v2
						variant="regular"
						:upload-tag="tileUploadTag(tileIndex)"
						:source="tilePreviewSource(tile)"
						:allow-multi-select="false"
						:default-folder="cmsPageState.pageEntityName"
						:caption="$t('cms.elements.jv-promo-deal-tiles.config.tiles.imageMedia.caption')"
						@media-upload-sidebar-open="onOpenTileMediaModal(tileIndex)"
						@media-upload-remove-image="onTileRemove(tileIndex)"
					/>

					<sw-upload-listener
						:upload-tag="tileUploadTag(tileIndex)"
						auto-upload
						@media-upload-finish="onTileUpload(tileIndex, $event)"
					/>
				</div>

				<mt-text-field
					v-model:model-value="tile.link.label"
					:label="$t('cms.elements.jv-promo-deal-tiles.config.tiles.link.label.label')"
					@update:model-value="onUpdate"
				/>

				<mt-text-field
					v-model:model-value="tile.link.url"
					:label="$t('cms.elements.jv-promo-deal-tiles.config.tiles.link.url.label')"
					:placeholder="$t('cms.elements.jv-promo-deal-tiles.config.tiles.link.url.placeholder')"
					@update:model-value="onUpdate"
				/>

				<mt-select
					v-model:model-value="tile.link.size"
					:label="$t('cms.elements.jv-promo-deal-tiles.config.tiles.link.size.label')"
					:options="sizeOptions"
					@update:model-value="onUpdate"
				/>
			</div>
		</div>

		<sw-media-modal-v2
			v-if="mediaModalIndex !== null"
			variant="full"
			:caption="$t('cms.elements.jv-promo-deal-tiles.config.tiles.imageMedia.caption')"
			:entity-context="cmsPageState.entityName"
			:allow-multi-select="false"
			:initial-folder-id="cmsPageState.defaultMediaFolderId"
			@media-modal-selection-change="onTileSelectionChanges"
			@modal-close="onCloseTileMediaModal"
		/>
	</div>
{% endblock %}
