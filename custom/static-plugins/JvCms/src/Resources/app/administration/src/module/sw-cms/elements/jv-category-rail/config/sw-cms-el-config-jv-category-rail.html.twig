{% block sw_cms_el_config_jv_category_rail %}
	<div class="sw-cms-el-config-jv-category-rail">
		<mt-text-field
			v-model:model-value="element.config.title.value"
			:label="$t('cms.elements.jv-category-rail.config.title.label')"
			:placeholder="$t('cms.elements.jv-category-rail.config.title.placeholder')"
			@update:model-value="onUpdate"
		/>

		<mt-text-field
			v-model:model-value="element.config.eyebrow.value"
			:label="$t('cms.elements.jv-category-rail.config.eyebrow.label')"
			:placeholder="$t('cms.elements.jv-category-rail.config.eyebrow.placeholder')"
			@update:model-value="onUpdate"
		/>

		<mt-textarea
			v-model:model-value="element.config.description.value"
			:label="$t('cms.elements.jv-category-rail.config.description.label')"
			:placeholder="$t('cms.elements.jv-category-rail.config.description.placeholder')"
			@update:model-value="onUpdate"
		/>

		<mt-select
			v-model:model-value="element.config.layout.value"
			:label="$t('cms.elements.jv-category-rail.config.layout.label')"
			:options="layoutOptions"
			@update:model-value="onUpdate"
		/>

		<div class="sw-cms-el-config-jv-category-rail__section">
			<div class="sw-cms-el-config-jv-category-rail__section-header">
				<h4>{{ $t('cms.elements.jv-category-rail.config.categories.title') }}</h4>
				<mt-button size="small" variant="secondary" @click="addCategory">
					{{ $t('cms.elements.jv-category-rail.config.categories.add') }}
				</mt-button>
			</div>

			<div
				v-for="(category, categoryIndex) in categories"
				:key="`jv-category-rail-${categoryIndex}`"
				class="sw-cms-el-config-jv-category-rail__card"
			>
				<div class="sw-cms-el-config-jv-category-rail__card-header">
					<strong>{{ $t('cms.elements.jv-category-rail.config.categories.cardTitle', { index: categoryIndex + 1 }) }}</strong>
					<mt-button size="small" variant="critical" @click="removeCategory(categoryIndex)">
						{{ $t('cms.elements.jv-category-rail.config.categories.remove') }}
					</mt-button>
				</div>

				<sw-entity-single-select
					v-model:value="category.categoryId"
					entity="category"
					:label="$t('cms.elements.jv-category-rail.config.categories.categoryId.label')"
					:placeholder="$t('cms.elements.jv-category-rail.config.categories.categoryId.placeholder')"
					show-clearable-button
					@update:value="onUpdate"
				/>

				<div class="sw-cms-el-config-jv-category-rail__media">
					<label class="sw-cms-el-config-jv-category-rail__media-label">
						{{ $t('cms.elements.jv-category-rail.config.categories.imageMedia.label') }}
					</label>

					<sw-media-upload-v2
						variant="regular"
						:upload-tag="categoryUploadTag(categoryIndex)"
						:source="categoryPreviewSource(category)"
						:allow-multi-select="false"
						:default-folder="cmsPageState.pageEntityName"
						:caption="$t('cms.elements.jv-category-rail.config.categories.imageMedia.caption')"
						@media-upload-sidebar-open="onOpenCategoryMediaModal(categoryIndex)"
						@media-upload-remove-image="onCategoryRemove(categoryIndex)"
					/>

					<sw-upload-listener
						:upload-tag="categoryUploadTag(categoryIndex)"
						auto-upload
						@media-upload-finish="onCategoryUpload(categoryIndex, $event)"
					/>
				</div>

				<mt-text-field
					v-model:model-value="category.id"
					:label="$t('cms.elements.jv-category-rail.config.categories.id.label')"
					:help-text="$t('cms.elements.jv-category-rail.config.categories.id.helpText')"
					@update:model-value="onUpdate"
				/>

				<mt-text-field
					v-model:model-value="category.label"
					:label="$t('cms.elements.jv-category-rail.config.categories.label.label')"
					@update:model-value="onUpdate"
				/>

				<mt-text-field
					v-model:model-value="category.url"
					:label="$t('cms.elements.jv-category-rail.config.categories.url.label')"
					:placeholder="$t('cms.elements.jv-category-rail.config.categories.url.placeholder')"
					@update:model-value="onUpdate"
				/>
			</div>
		</div>

		<div class="sw-cms-el-config-jv-category-rail__section">
			<h4>{{ $t('cms.elements.jv-category-rail.config.viewAll.title') }}</h4>

			<mt-text-field
				v-model:model-value="element.config.viewAll.value.label"
				:label="$t('cms.elements.jv-category-rail.config.viewAll.label.label')"
				:placeholder="$t('cms.elements.jv-category-rail.config.viewAll.label.placeholder')"
				@update:model-value="onUpdate"
			/>

			<mt-text-field
				v-model:model-value="element.config.viewAll.value.url"
				:label="$t('cms.elements.jv-category-rail.config.viewAll.url.label')"
				:placeholder="$t('cms.elements.jv-category-rail.config.viewAll.url.placeholder')"
				@update:model-value="onUpdate"
			/>
		</div>

		<sw-media-modal-v2
			v-if="mediaModalIndex !== null"
			variant="full"
			:caption="$t('cms.elements.jv-category-rail.config.categories.imageMedia.caption')"
			:entity-context="cmsPageState.entityName"
			:allow-multi-select="false"
			:initial-folder-id="cmsPageState.defaultMediaFolderId"
			@media-modal-selection-change="onCategorySelectionChanges"
			@modal-close="onCloseCategoryMediaModal"
		/>
	</div>
{% endblock %}
